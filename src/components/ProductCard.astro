---
import Icon from './Icon.astro';
import { formatPrice, type Product } from '../data/catalog';
interface Props { product: Product; index?: number; compare?: boolean; compact?: boolean }
const { product, compact = false } = Astro.props;
const productImage = product.kind === 'car' ? product.image : product.image;
---
<article class:list={['shop-card', { 'shop-card-compact': compact, 'shop-card-accessory': product.kind === 'accessory' }]} data-product-card data-family={product.family} data-kind={product.kind} data-slug={product.slug} data-search={`${product.name} ${product.category} ${product.shortDescription}`}>
  <a class="shop-card-link" href={`/products/${product.slug}/`} aria-label={`查看 ${product.name} 的配置和参数`}>
    <div class="shop-card-image">
      {product.badge && <span class="shop-card-badge">{product.badge}</span>}
      <img src={productImage} alt={`${product.name} ${product.kind === 'car' ? '玩具机器人车' : '机器人配件'}`} width="720" height="640" loading="lazy"/>
      <span class="shop-card-explore">了解产品 <Icon name="diagonal" size={15}/></span>
    </div>
    <div class="shop-card-content">
      <span class="shop-card-category">{product.category}</span>
      <h3>{product.name}</h3>
      <p>{product.shortDescription}</p>
    </div>
  </a>
  <div class="shop-card-purchase">
    <div class="shop-card-price"><span>{formatPrice(product.priceCNY)}</span><small>展示价</small></div>
    <button class="shop-card-cart" data-add-to-cart={product.slug} aria-label={`将 ${product.name} 加入购物车`} title="加入购物车"><Icon name="cart" size={21}/></button>
  </div>
</article>
<style>
  .shop-card{position:relative;background:#f5f5f5;display:flex;flex-direction:column;min-width:0;transition:background .22s,box-shadow .22s;overflow:hidden;border:1px solid transparent;color:#111318}
  .shop-card:hover{background:#f0f2f5;box-shadow:0 10px 34px #172c4610;border-color:#e1e7f0}
  .shop-card-link{display:block;flex:1;min-width:0}
  .shop-card-image{position:relative;aspect-ratio:1.22;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:30px 22px 8px}
  .shop-card-image img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .55s cubic-bezier(.2,.65,.3,1)}
  .shop-card:hover .shop-card-image img{transform:translateY(-5px) scale(1.035)}
  .shop-card-badge{position:absolute;left:21px;top:18px;z-index:1;font-size:10px;letter-spacing:.04em;color:#086df5;background:#ffffffc7;padding:4px 9px;border:1px solid #e6eaf0;border-radius:2px}
  .shop-card-explore{position:absolute;right:20px;bottom:12px;display:flex;gap:8px;align-items:center;font-size:10px;color:#787e88;opacity:0;transition:opacity .2s}
  .shop-card:hover .shop-card-explore,.shop-card:focus-within .shop-card-explore{opacity:1}
  .shop-card-content{padding:14px 25px 0;text-align:center}
  .shop-card-category{color:#8b8e96;font-size:10px;letter-spacing:.08em}
  .shop-card-content h3{font-size:25px;font-weight:620;letter-spacing:-.7px;margin:7px 0 10px;line-height:1.25;color:#17191e}
  .shop-card-content p{font-size:13px;font-weight:400;line-height:1.65;color:#747880;min-height:43px;max-width:340px;margin:0 auto}
  .shop-card-purchase{padding:21px 25px 25px;display:flex;align-items:center;justify-content:space-between;gap:14px}
  .shop-card-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:9px}
  .shop-card-price>span{font-size:21px;letter-spacing:-.5px;font-weight:650}
  .shop-card-price>small{font-size:10px;font-weight:400;color:#9297a0}
  .shop-card-cart{border:1px solid #d9dee7;width:39px;height:39px;display:flex;align-items:center;justify-content:center;background:transparent;color:#161c27;border-radius:50%;flex-shrink:0;transition:background .2s,color .2s,border-color .2s}
  .shop-card-cart:hover{background:#0875ff;border-color:#0875ff;color:white}
  .shop-card-compact .shop-card-image{aspect-ratio:1.15;padding:31px 15px 8px}
  .shop-card-compact .shop-card-badge{left:11px;top:10px;font-size:8px;padding:2px 6px}
  .shop-card-compact .shop-card-content{padding:12px 15px 0}
  .shop-card-compact .shop-card-category{font-size:8px}
  .shop-card-compact .shop-card-content h3{font-size:17px;letter-spacing:-.3px;margin:6px 0}
  .shop-card-compact .shop-card-content p{font-size:10px;min-height:33px;line-height:1.6}
  .shop-card-compact .shop-card-purchase{padding:14px 14px 17px;gap:6px}
  .shop-card-compact .shop-card-price{gap:4px}
  .shop-card-compact .shop-card-price>span{font-size:17px}
  .shop-card-compact .shop-card-price>small{font-size:8px}
  .shop-card-compact .shop-card-cart{width:30px;height:30px}
  .shop-card-compact .shop-card-cart svg{width:17px;height:17px}
  @media(max-width:640px){.shop-card-image{padding:26px 10px 2px;aspect-ratio:1.07}.shop-card-badge{left:10px;top:11px;font-size:8px;padding:3px 6px}.shop-card-content{padding:12px 12px 0}.shop-card-content h3{font-size:18px;letter-spacing:-.4px;margin:6px 0}.shop-card-category{font-size:8px}.shop-card-content p{font-size:10px;min-height:48px}.shop-card-purchase{padding:14px 12px 16px;gap:6px;align-items:center}.shop-card-price{gap:2px;flex-direction:column}.shop-card-price>span{font-size:18px;letter-spacing:-.5px}.shop-card-price>small{font-size:8px}.shop-card-cart{width:32px;height:32px}.shop-card-cart svg{width:18px;height:18px}.shop-card-explore{display:none}.shop-card-compact .shop-card-image{aspect-ratio:1.07;padding:26px 10px 2px}.shop-card-compact .shop-card-content p{min-height:48px}.shop-card-compact .shop-card-price>span{font-size:18px}.shop-card-compact .shop-card-purchase{padding:14px 12px 16px}}
  @media(prefers-reduced-motion:reduce){.shop-card,.shop-card *{transition:none}}
</style>
