---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { articles } from '../../data/articles';
const featured = articles[0];
const categories = ['全部探索', '前沿科技', '应用与选型'];
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.robotdog.com/' },
  { '@type': 'ListItem', position: 2, name: '探索与未来', item: 'https://www.robotdog.com/journal/' },
] };
---
<Layout title="探索与未来｜具身智能、世界模型与机器人前沿科技｜RobotDog" description="探索具身智能、世界模型、数字孪生、群体协作、空间智能与边缘推理，发现机器人前沿研究与真实应用的连接。" schema={schema}>
  <section class="future-hero"><img src="/images/scenes/future.jpg" alt="具有未来科技氛围的机器人研究空间概念图" width="1536" height="1024" fetchpriority="high"/><div class="future-hero-shade"></div><div class="future-hero-copy"><span>ROBOTDOG / EXPLORE WHAT’S NEXT</span><h1>未来，不止于想象。</h1><p>让智能拥有身体，让想法走进现实。<br/>一起探索科技的下一种可能。</p><a href="#explore">探索与未来 <Icon name="arrow" size={19}/></a></div><div class="future-hero-bottom"><span>INTELLIGENCE · MOTION · POSSIBILITY</span><span>向更远的未来，迈出一步。</span></div></section>
  <section class="container future-feature" id="explore"><div class="future-feature-copy"><span class="future-kicker">FEATURED / {featured.category}</span><h2>{featured.title}</h2><p>{featured.excerpt}</p><a href={`/journal/${featured.slug}/`}>走进具身智能 <Icon name="diagonal" size={20}/></a><div class="future-feature-tags"><span>感知</span><i></i><span>决策</span><i></i><span>行动</span></div></div><a class="future-feature-image" href={`/journal/${featured.slug}/`} aria-label={`阅读全文：${featured.title}`}><img src={featured.coverImage} alt="具身智能与机器人研究的未来概念场景" width="1536" height="1024" loading="lazy"/><span><Icon name="diagonal" size={25}/></span></a></section>
  <section class="container future-library"><div class="future-library-heading"><div><span class="future-kicker">THE NEXT FRONTIER</span><h2>每一次探索，<br/>都在重新定义可能。</h2></div><p>从前沿研究到应用实践。<br/>读懂变化，也找到自己的下一步。</p></div><div class="future-filters" aria-label="按主题筛选文章">{categories.map((category, index) => <button type="button" class:list={[{ active: index === 0 }]} data-article-filter={index} aria-pressed={index === 0 ? 'true' : 'false'}>{category}<span>{index === 0 ? articles.length : index === 1 ? 6 : 3}</span></button>)}</div><div class="future-story-grid">{articles.map((article, index) => <a class="future-story-card" href={`/journal/${article.slug}/`} data-article-group={index < 6 ? '1' : '2'}><div class="future-story-image"><img src={article.coverImage} alt={`${article.category}主题概念场景`} width="1536" height="1024" loading="lazy"/><span>{article.category}</span><i><Icon name="diagonal" size={19}/></i></div><div class="future-story-meta"><span>{article.eyebrow || 'IDEAS INTO PRACTICE'}</span><span>{article.readTime}</span></div><h3>{article.title}</h3><p>{article.excerpt}</p><span class="future-story-date">编辑于 {article.date.replaceAll('-', '.')}</span></a>)}</div></section>
  <section class="future-manifesto"><img src="/images/scenes/exploration.jpg" alt="机器狗面向户外未知环境的探索概念场景" width="1536" height="1024" loading="lazy"/><div class="future-manifesto-shade"></div><div class="container"><span class="future-kicker">THE FUTURE IS A DIRECTION</span><h2>让每一个“如果”，<br/>成为下一次探索的起点。</h2><p>精彩的未来，需要想象力，也需要一次次真实的验证。<br/>从合适的机器人平台开始，让你的想法拥有行动的载体。</p><div><a href="/solutions/research/">探索研发场景 <Icon name="diagonal" size={18}/></a><a href="/products/">发现产品系列 <Icon name="arrow" size={18}/></a></div></div></section>
</Layout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-article-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-article-group]');
  filters.forEach((button) => button.addEventListener('click', () => {
    const filter = button.dataset.articleFilter;
    filters.forEach((item) => { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-pressed', String(active)); });
    cards.forEach((card) => { card.hidden = filter !== '0' && card.dataset.articleGroup !== filter; });
  }));
</script>
<style>
  .future-hero{position:relative;height:710px;margin-top:80px;overflow:hidden;background:#060c18;color:#fff}.future-hero>img,.future-hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.future-hero-shade{background:linear-gradient(0deg,#030918d6,#03091844 80%),linear-gradient(90deg,#03091840,#03091820)}.future-hero-copy{position:relative;z-index:1;text-align:center;padding:200px 25px 0}.future-hero-copy>span{font-size:12px;color:#b9cdf0;letter-spacing:.22em}.future-hero h1{font-size:clamp(45px,5.4vw,80px);font-weight:600;letter-spacing:-.04em;margin:30px 0 25px;line-height:1.3}.future-hero-copy>p{font-size:18px;line-height:1.9;color:#d4dff0;margin-bottom:35px}.future-hero-copy>a{display:inline-flex;gap:24px;align-items:center;padding:14px 27px;background:#1674ff;color:#fff;font-size:14px}.future-hero-bottom{position:absolute;left:6%;right:6%;bottom:32px;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.1em;color:#b2c5e4}.future-kicker{font-size:11px;font-weight:600;letter-spacing:.15em;color:#1674ff}.future-feature{display:grid;grid-template-columns:1fr 1.2fr;gap:75px;align-items:center;padding:95px 0;scroll-margin-top:100px}.future-feature h2{font-size:clamp(30px,3vw,43px);line-height:1.5;letter-spacing:-.035em;margin:22px 0}.future-feature-copy>p{font-size:15px;line-height:1.95;color:#737d8b;max-width:470px}.future-feature-copy>a{display:inline-flex;gap:22px;align-items:center;font-size:14px;color:#1674ff;margin-top:30px}.future-feature-tags{display:flex;align-items:center;gap:18px;margin-top:38px;font-size:11px;color:#8b95a4}.future-feature-tags i{width:25px;height:1px;background:#d6deea}.future-feature-image{position:relative;overflow:hidden;aspect-ratio:1.16;background:#0c1423}.future-feature-image>img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.future-feature-image:hover>img{transform:scale(1.04)}.future-feature-image>span{position:absolute;right:25px;bottom:25px;width:50px;height:50px;border-radius:50%;background:#1674ff;color:#fff;display:grid;place-items:center}.future-library{padding-bottom:100px}.future-library-heading{display:flex;justify-content:space-between;gap:45px;align-items:end;margin-bottom:40px}.future-library-heading h2{font-size:40px;line-height:1.4;letter-spacing:-.03em;margin:20px 0 0}.future-library-heading>p{font-size:15px;line-height:1.9;color:#7b8593}.future-filters{display:flex;gap:35px;border-bottom:1px solid #e1e6ed;margin-bottom:35px}.future-filters>button{padding:16px 0;border-bottom:2px solid transparent;background:none;font-size:14px;color:#7b8798}.future-filters>button span{font-size:10px;margin-left:9px;color:#9aa5b5}.future-filters>button.active{color:#1674ff;border-color:#1674ff}.future-story-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:45px 25px}.future-story-card[hidden]{display:none}.future-story-image{position:relative;aspect-ratio:1.28;overflow:hidden;background:#0c1423}.future-story-image>img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.future-story-card:hover .future-story-image>img{transform:scale(1.055)}.future-story-image>span{position:absolute;top:18px;left:18px;background:#ffffffef;color:#2c3747;padding:6px 11px;font-size:10px}.future-story-image>i{position:absolute;bottom:18px;right:18px;width:34px;height:34px;background:#1674ff;color:#fff;display:grid;place-items:center;font-style:normal}.future-story-meta{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:9px;color:#99a3b2;margin-top:20px;letter-spacing:.06em}.future-story-meta>span:first-child{color:#1674ff}.future-story-card h3{font-size:22px;line-height:1.55;letter-spacing:-.025em;margin:15px 0 12px}.future-story-card>p{font-size:13px;color:#7a8391;line-height:1.9;margin:0 0 23px}.future-story-date{font-size:10px;color:#a2aab7}.future-manifesto{position:relative;overflow:hidden;min-height:590px;color:#fff;background:#050b16;display:flex;align-items:center;text-align:center}.future-manifesto>img,.future-manifesto-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.future-manifesto-shade{background:#030a17ad}.future-manifesto>.container{position:relative;padding:85px 0}.future-manifesto .future-kicker{color:#a7caff}.future-manifesto h2{font-size:clamp(33px,4vw,55px);line-height:1.4;letter-spacing:-.025em;margin:25px 0}.future-manifesto p{font-size:15px;color:#c6d3e6;line-height:2}.future-manifesto .container>div{display:flex;justify-content:center;gap:30px;align-items:center;margin-top:35px}.future-manifesto a{display:flex;align-items:center;gap:18px;font-size:13px}.future-manifesto a:first-child{background:#1674ff;padding:14px 22px}
  @media(max-width:950px){.future-feature{gap:35px}.future-feature h2{font-size:32px}.future-story-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.future-library-heading h2{font-size:34px}}
  @media(max-width:640px){.future-hero{height:600px;margin-top:68px}.future-hero>img{object-position:62% 50%}.future-hero-copy{padding:175px 20px 0}.future-hero-copy>span{font-size:9px;letter-spacing:.13em}.future-hero h1{font-size:41px;margin:25px 0}.future-hero-copy>p{font-size:14px;line-height:1.9;margin-bottom:27px}.future-hero-copy>a{font-size:12px;padding:13px 23px;gap:20px}.future-hero-bottom{left:20px;right:20px;font-size:8px;bottom:25px}.future-hero-bottom>span:last-child{display:none}.future-kicker{font-size:9px}.future-feature{grid-template-columns:1fr;gap:28px;padding:55px 0}.future-feature h2{font-size:31px;line-height:1.45}.future-feature-copy>p{font-size:14px}.future-feature-copy>a{font-size:12px;margin-top:23px}.future-feature-tags{margin-top:28px;font-size:10px}.future-feature-image{aspect-ratio:1.23}.future-library{padding-bottom:60px}.future-library-heading{align-items:start;flex-direction:column;gap:20px;margin-bottom:25px}.future-library-heading h2{font-size:30px}.future-library-heading>p{font-size:13px;margin:0}.future-filters{gap:25px;margin-bottom:25px}.future-filters>button{font-size:12px;padding:15px 0}.future-filters>button span{font-size:9px;margin-left:5px}.future-story-grid{grid-template-columns:1fr;gap:32px}.future-story-image{aspect-ratio:1.35}.future-story-card h3{font-size:23px}.future-story-card>p{font-size:13px;margin-bottom:18px}.future-story-meta{font-size:9px}.future-manifesto{min-height:500px}.future-manifesto>.container{padding:60px 0}.future-manifesto h2{font-size:31px}.future-manifesto p{font-size:12px;line-height:2}.future-manifesto .container>div{gap:22px;margin-top:27px}.future-manifesto a{font-size:11px;gap:10px}.future-manifesto a:first-child{padding:13px 17px}}
</style>
