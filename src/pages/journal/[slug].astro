---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { articles, type Article } from '../../data/articles';
export function getStaticPaths() { return articles.map((article) => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props as { article: Article };
const related = articles.filter((item) => item.slug !== article.slug).slice(0, 3);
const articleUrl = `https://robotdogcxy.xyz/journal/${article.slug}/`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://robotdogcxy.xyz/' },
    { '@type': 'ListItem', position: 2, name: '探索与未来', item: 'https://robotdogcxy.xyz/journal/' },
    { '@type': 'ListItem', position: 3, name: article.title, item: articleUrl },
  ] },
  { '@context': 'https://schema.org', '@type': 'Article', headline: article.title, description: article.seoDescription,
    datePublished: article.date, dateModified: article.date, inLanguage: 'zh-CN', mainEntityOfPage: articleUrl,
    author: { '@type': 'Organization', name: 'RobotDog', url: 'https://robotdogcxy.xyz/' },
    publisher: { '@type': 'Organization', name: 'RobotDog', url: 'https://robotdogcxy.xyz/' },
    image: `https://robotdogcxy.xyz${article.coverImage}`, articleSection: article.category,
  },
];
---
<Layout title={article.seoTitle} description={article.seoDescription} schema={schema}>
  <section class="insight-hero"><img src={article.coverImage} alt={`${article.category}主题概念场景`} width="1536" height="1024" fetchpriority="high"/><div class="insight-hero-shade"></div><div class="container insight-hero-content"><nav aria-label="面包屑导航"><a href="/">首页</a><span>/</span><a href="/journal/">探索与未来</a><span>/</span><span aria-current="page">{article.category}</span></nav><span class="insight-kicker">{article.eyebrow || 'IDEAS INTO PRACTICE'} / {article.category}</span><h1>{article.title}</h1><p>{article.excerpt}</p><div class="insight-byline"><span>RobotDog 编辑</span><time datetime={article.date}>编辑于 {article.date.replaceAll('-', '.')}</time><span><Icon name="clock" size={15}/>{article.readTime}</span></div></div></section>
  <div class="container insight-body">
    <aside class="insight-toc" aria-label="文章目录"><span class="insight-kicker">阅读导航</span><nav>{article.sections.map((section, index) => <a href={`#section-${index + 1}`}><span>0{index + 1}</span>{section.heading}</a>)}</nav><a class="insight-back" href="/journal/"><Icon name="arrow" size={16}/>返回探索与未来</a></aside>
    <article class="insight-prose">{article.sections.map((section, index) => <section id={`section-${index + 1}`}><span class="insight-section-number">0{index + 1}</span><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.bullets && <ul>{section.bullets.map((bullet) => <li><Icon name="check" size={17}/>{bullet}</li>)}</ul>}{index === 1 && <figure><img src={article.coverImage} alt={`${article.category}研究与应用的概念示意`} width="1536" height="1024" loading="lazy"/><figcaption>{article.category} / 从方向解读，到真实的探索。图片为场景概念示意。</figcaption></figure>}</section>)}
      <div class="insight-next-step"><span class="insight-kicker">YOUR NEXT STEP</span><h3>让下一次探索，<br/>从一个具体目标开始。</h3><p>把使用目的、场地和接口需求整理清楚，为想法找到适合的机器人平台。</p><div><a href="/products/">查看产品与配置 <Icon name="diagonal" size={17}/></a><button data-inquiry>咨询选型 <Icon name="arrow" size={17}/></button></div></div>
    </article>
  </div>
  <section class="insight-related"><div class="container"><div class="insight-related-heading"><div><span class="insight-kicker">KEEP EXPLORING</span><h2>更远的未来，还有更多可能。</h2></div><a href="/journal/">全部探索 <Icon name="arrow" size={18}/></a></div><div class="insight-related-grid">{related.map((item) => <a href={`/journal/${item.slug}/`}><div class="insight-related-image"><img src={item.coverImage} alt={`${item.category}主题概念场景`} width="1536" height="1024" loading="lazy"/><span>{item.category}</span></div><h3>{item.title}</h3><p>{item.excerpt}</p><span class="insight-reading-bottom">{item.readTime}<Icon name="diagonal" size={18}/></span></a>)}</div></div></section>
</Layout>
<style>
  .insight-hero{position:relative;min-height:635px;margin-top:80px;overflow:hidden;background:#07101d;color:#fff}.insight-hero>img,.insight-hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.insight-hero-shade{background:linear-gradient(90deg,#020817ed,#0208179e 58%,#02081735),linear-gradient(0deg,#0208179e,transparent 85%)}.insight-hero-content{position:relative;padding-top:33px;padding-bottom:90px}.insight-hero-content nav{display:flex;align-items:center;gap:13px;color:#b2c0d6;font-size:11px;margin-bottom:95px}.insight-hero-content nav a:hover{color:#fff}.insight-kicker{font-size:11px;color:#1674ff;letter-spacing:.14em;font-weight:600}.insight-hero .insight-kicker{color:#a7c6f8}.insight-hero h1{font-size:clamp(37px,4.5vw,63px);line-height:1.4;letter-spacing:-.03em;max-width:1000px;margin:25px 0}.insight-hero-content>p{font-size:17px;line-height:1.9;max-width:700px;color:#c5d1e2;margin:0}.insight-byline{display:flex;align-items:center;flex-wrap:wrap;gap:25px;font-size:11px;color:#9bb0ce;margin-top:33px}.insight-byline>span:last-child{display:flex;gap:7px;align-items:center}.insight-body{display:grid;grid-template-columns:240px minmax(0,760px);gap:80px;justify-content:center;align-items:start;padding-top:85px;padding-bottom:90px}.insight-toc{position:sticky;top:110px;border-left:1px solid #dce4ee;padding:4px 0 5px 25px}.insight-toc nav{display:grid;gap:23px;margin:30px 0}.insight-toc nav>a{display:flex;gap:13px;line-height:1.8;color:#778497;font-size:12px}.insight-toc nav>a:hover{color:#1674ff}.insight-toc nav>a>span{font-size:9px;color:#a3afc0;padding-top:3px}.insight-back{display:flex;align-items:center;gap:11px;font-size:11px;color:#42546f}.insight-back svg{transform:rotate(180deg)}.insight-prose section{scroll-margin-top:115px;margin-bottom:50px}.insight-section-number{font-size:12px;color:#1674ff;letter-spacing:.08em}.insight-prose h2{font-size:29px;line-height:1.6;letter-spacing:-.025em;margin:13px 0 25px}.insight-prose p{font-size:16px;line-height:2;color:#586678;margin:0 0 22px}.insight-prose ul{list-style:none;margin:28px 0;padding:25px 30px;background:#f3f6fa;border-left:3px solid #1674ff}.insight-prose li{display:flex;align-items:flex-start;gap:13px;font-size:14px;line-height:1.9;color:#5a6b81;margin:10px 0}.insight-prose li svg{flex-shrink:0;margin-top:5px;color:#1674ff}.insight-prose figure{margin:35px 0 0}.insight-prose figure>img{width:100%;height:auto;aspect-ratio:1.6;object-fit:cover}.insight-prose figcaption{font-size:10px;line-height:1.8;color:#98a3b3;margin-top:12px}.insight-next-step{padding:40px;background:#0c1423;color:#fff;margin-top:65px}.insight-next-step .insight-kicker{color:#8db8ff}.insight-next-step h3{font-size:31px;line-height:1.45;letter-spacing:-.025em;margin:20px 0}.insight-next-step>p{font-size:14px;color:#9dacc3;margin-bottom:27px}.insight-next-step>div{display:flex;align-items:center;gap:27px}.insight-next-step a,.insight-next-step button{display:inline-flex;align-items:center;gap:18px;font-size:12px;color:#fff}.insight-next-step a{padding:14px 20px;background:#1674ff}.insight-next-step button{background:none}.insight-related{padding:80px 0;background:#f3f6fa}.insight-related-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:35px}.insight-related-heading h2{font-size:32px;line-height:1.45;margin:20px 0 0;letter-spacing:-.025em}.insight-related-heading>a{display:flex;align-items:center;gap:13px;font-size:12px}.insight-related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.insight-related-grid>a{display:block}.insight-related-image{position:relative;aspect-ratio:1.35;overflow:hidden;background:#0b1321}.insight-related-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.insight-related-grid>a:hover img{transform:scale(1.04)}.insight-related-image>span{position:absolute;top:17px;left:17px;background:#ffffffeb;color:#374658;padding:6px 10px;font-size:10px}.insight-related-grid h3{font-size:22px;line-height:1.6;margin:20px 0 12px;letter-spacing:-.02em}.insight-related-grid p{font-size:13px;line-height:1.9;color:#7c8798;margin:0}.insight-reading-bottom{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#96a1b1;margin-top:23px}.insight-reading-bottom svg{color:#1674ff}
  @media(max-width:1000px){.insight-body{grid-template-columns:200px minmax(0,1fr);gap:40px}.insight-hero h1{font-size:48px}.insight-prose h2{font-size:25px}}
  @media(max-width:640px){.insight-hero{margin-top:68px;min-height:600px}.insight-hero>img{object-position:65% 50%}.insight-hero-content{padding-top:25px;padding-bottom:65px}.insight-hero-content nav{font-size:9px;gap:9px;margin-bottom:77px}.insight-kicker{font-size:9px}.insight-hero h1{font-size:34px;line-height:1.5;margin:24px 0 21px;letter-spacing:-.025em}.insight-hero-content>p{font-size:13px;line-height:1.9}.insight-byline{font-size:9px;gap:15px;margin-top:28px}.insight-body{grid-template-columns:1fr;gap:35px;padding:40px 0 55px}.insight-toc{position:static;border-left:2px solid #1674ff;padding:20px;background:#f4f6fa}.insight-toc nav{gap:14px;margin:20px 0 0}.insight-toc nav>a{font-size:11px}.insight-back{display:none}.insight-prose h2{font-size:24px;margin:12px 0 20px}.insight-prose p{font-size:14px;line-height:2}.insight-prose section{margin-bottom:35px}.insight-prose ul{padding:18px 20px}.insight-prose li{font-size:12px;gap:10px}.insight-prose figcaption{font-size:9px}.insight-next-step{padding:27px;margin-top:40px}.insight-next-step h3{font-size:27px}.insight-next-step>p{font-size:12px}.insight-next-step>div{gap:20px}.insight-next-step a,.insight-next-step button{font-size:11px;gap:10px}.insight-next-step a{padding:12px 15px}.insight-related{padding:55px 0}.insight-related-heading{align-items:start;flex-direction:column;gap:22px}.insight-related-heading h2{font-size:27px}.insight-related-heading>a{font-size:11px}.insight-related-grid{grid-template-columns:1fr;gap:30px}.insight-related-image{aspect-ratio:1.6}.insight-related-grid h3{font-size:23px}.insight-related-grid p{font-size:12px}}
</style>
