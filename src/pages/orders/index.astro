---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { products, formatPrice } from '../../data/catalog';
---
<Layout title="购物车与订单｜RobotCar" description="查看已选玩具机器人车和配件，调整数量、核对价格，并继续填写订单信息。" noindex>
  <section class="cart-page container">
    <div class="breadcrumb"><a href="/">首页</a><span>/</span><a href="/products/">产品系列</a><span>/</span><span>购物车</span></div>
    <div class="commerce-heading"><div><span class="eyebrow">YOUR NEXT MOVE</span><h1>你的机器人清单。</h1><p>每一份探索，都从选对装备开始。</p></div><a class="continue-shopping" href="/products/">继续选购 <Icon name="arrow" size={18}/></a></div>
    <ol class="checkout-steps" aria-label="购买流程"><li class="current"><span>01</span>购物车</li><li><span>02</span>确认订单</li><li><span>03</span>支付演示</li></ol>
    <div class="empty-cart" id="empty-cart"><div class="empty-icon"><Icon name="cart" size={48}/></div><h2>下一位同行者，还在等你。</h2><p>探索玩具机器人车、传感器与开发配件，组合属于你的机器人装备。</p><a href="/products/" class="button button-dark">发现全部产品 <Icon name="arrow" size={18}/></a></div>
    <div id="cart-content" hidden>
      <div class="cart-table-head"><label class="select-all"><input type="checkbox" id="select-all" checked/><span>全选</span></label><span>产品信息</span><span>单价</span><span>数量</span><span>小计</span></div>
      <div class="cart-rows" id="cart-rows">
        {products.map(product => <article class="cart-row" data-cart-row={product.slug} hidden><label class="item-selector"><input type="checkbox" data-select-item={product.slug} aria-label={`选择 ${product.name}`} checked/></label><a href={`/products/${product.slug}/`} class="cart-product"><div class="cart-photo"><img src={product.image} alt={product.name} width="180" height="160"/></div><div><span class="product-kind">{product.kind === 'accessory' ? '机器人配件' : '智能玩具车'}</span><h2>{product.name}</h2><p>{product.tagline}</p><span class="view-detail">查看配置与参数 <Icon name="diagonal" size={13}/></span></div></a><div class="cart-unit-price"><span class="mobile-label">单价</span>{formatPrice(product.priceCNY)}</div><div class="quantity-control"><button type="button" data-quantity-minus={product.slug} aria-label={`减少 ${product.name} 数量`}>−</button><input type="number" inputmode="numeric" min="1" max="99" value="1" data-quantity={product.slug} aria-label={`${product.name} 数量`}/><button type="button" data-quantity-plus={product.slug} aria-label={`增加 ${product.name} 数量`}>+</button></div><div class="cart-subtotal"><span class="mobile-label">小计</span><strong data-subtotal={product.slug}>{formatPrice(product.priceCNY)}</strong><button type="button" class="remove-item" data-remove-item={product.slug}>移除</button></div></article>)}
      </div>
      <div class="cart-bottom-note"><Icon name="shield" size={17}/><span>当前为购物流程预览，价格与配置为展示信息，正式报价以销售确认为准。</span></div>
      <div class="cart-checkout-bar"><div><label class="select-all"><input type="checkbox" id="select-all-bottom" checked/><span>全选</span></label><button type="button" id="remove-selected" class="remove-selected">移除所选</button><span class="selected-count">已选 <strong id="selected-count">0</strong> 件商品</span></div><div class="checkout-total"><span>商品合计 <strong id="cart-total">¥0</strong><small>运费在订单页确认</small></span><button type="button" class="button button-dark" id="go-checkout">去结算 <Icon name="arrow" size={18}/></button></div></div>
      <p class="cart-live" id="cart-live" aria-live="polite"></p>
    </div>
    <aside class="commerce-assurance"><div><Icon name="shield" size={27}/><strong>配置一目了然</strong><span>完整规格与配件适配说明</span></div><div><Icon name="code" size={27}/><strong>开发从容开始</strong><span>编程教育、教学与场景选型</span></div><div><Icon name="arrow" size={27}/><strong>一站式选购</strong><span>整机与配件，统一核对</span></div></aside>
  </section>
  <script>
    import { products, formatPrice } from '../../data/catalog';
    import { CART_EVENT, SELECTION_KEY, getCart, readStored, writeStored, setQuantity, removeFromCart, navigateTo } from '../../lib/cart';
    const allTop = document.getElementById('select-all') as HTMLInputElement;
    const allBottom = document.getElementById('select-all-bottom') as HTMLInputElement;
    let selection = new Set<string>();
    const saved = readStored<unknown>(SELECTION_KEY);
    getCart().forEach(item => { if (!Array.isArray(saved) || saved.includes(item.slug)) selection.add(item.slug); });
    const persistSelection = () => writeStored(SELECTION_KEY, [...selection]);
    function renderCart() {
      const items = getCart();
      const storedSelection = readStored<unknown>(SELECTION_KEY);
      selection = new Set(items.filter(item => !Array.isArray(storedSelection) || storedSelection.includes(item.slug)).map(item => item.slug));
      document.getElementById('empty-cart')!.hidden = items.length > 0;
      document.getElementById('cart-content')!.hidden = items.length === 0;
      document.querySelectorAll<HTMLElement>('[data-cart-row]').forEach(row => {
        const item = items.find(item => item.slug === row.dataset.cartRow);
        row.hidden = !item;
        if (!item) return;
        const product = products.find(product => product.slug === item.slug)!;
        const input = row.querySelector<HTMLInputElement>('[data-quantity]')!;
        input.value = String(item.quantity);
        row.querySelector<HTMLInputElement>('[data-select-item]')!.checked = selection.has(item.slug);
        row.querySelector<HTMLElement>('[data-subtotal]')!.textContent = formatPrice(product.priceCNY * item.quantity);
        (row.querySelector('[data-quantity-minus]') as HTMLButtonElement).disabled = item.quantity <= 1;
        (row.querySelector('[data-quantity-plus]') as HTMLButtonElement).disabled = item.quantity >= 99;
      });
      const selected = items.filter(item => selection.has(item.slug));
      const count = selected.reduce((total, item) => total + item.quantity, 0);
      const total = selected.reduce((sum, item) => sum + products.find(product => product.slug === item.slug)!.priceCNY * item.quantity, 0);
      document.getElementById('selected-count')!.textContent = String(count);
      document.getElementById('cart-total')!.textContent = formatPrice(total);
      (document.getElementById('go-checkout') as HTMLButtonElement).disabled = selected.length === 0;
      (document.getElementById('remove-selected') as HTMLButtonElement).disabled = selected.length === 0;
      [allTop, allBottom].forEach(input => { input.checked = items.length > 0 && selected.length === items.length; input.indeterminate = selected.length > 0 && selected.length < items.length; });
    }
    document.querySelectorAll<HTMLInputElement>('[data-select-item]').forEach(input => input.addEventListener('change', () => { if (input.checked) selection.add(input.dataset.selectItem!); else selection.delete(input.dataset.selectItem!); persistSelection(); renderCart(); }));
    [allTop, allBottom].forEach(input => input.addEventListener('change', () => { selection = new Set(input.checked ? getCart().map(item => item.slug) : []); persistSelection(); renderCart(); }));
    document.querySelectorAll<HTMLButtonElement>('[data-quantity-minus], [data-quantity-plus]').forEach(button => button.addEventListener('click', () => { const slug = button.dataset.quantityMinus || button.dataset.quantityPlus!; const item = getCart().find(item => item.slug === slug); if (item) setQuantity(slug, item.quantity + (button.dataset.quantityPlus ? 1 : -1)); }));
    document.querySelectorAll<HTMLInputElement>('[data-quantity]').forEach(input => input.addEventListener('change', () => { setQuantity(input.dataset.quantity!, Number(input.value)); }));
    document.querySelectorAll<HTMLButtonElement>('[data-remove-item]').forEach(button => button.addEventListener('click', () => { const product = products.find(product => product.slug === button.dataset.removeItem)!; removeFromCart(product.slug); document.getElementById('cart-live')!.textContent = `${product.name} 已从购物车移除。`; }));
    document.getElementById('remove-selected')?.addEventListener('click', () => { [...selection].forEach(removeFromCart); document.getElementById('cart-live')!.textContent = '已移除所选商品。'; });
    document.getElementById('go-checkout')?.addEventListener('click', () => { persistSelection(); if (getCart().some(item => selection.has(item.slug))) navigateTo('/checkout/'); });
    window.addEventListener(CART_EVENT, renderCart);
    window.addEventListener('pageshow', renderCart);
    renderCart();
  </script>
  <style>
    .cart-page{padding-top:128px;padding-bottom:64px;max-width:1400px}.breadcrumb{display:flex;gap:12px;color:#9297a1;font-size:12px;margin-bottom:32px}.breadcrumb a:hover{color:#1677ff}.commerce-heading{display:flex;justify-content:space-between;align-items:center;gap:30px}.commerce-heading .eyebrow{color:#1677ff;font-size:10px;letter-spacing:2px}.commerce-heading h1{font-size:43px;letter-spacing:-1px;font-weight:600;margin:12px 0}.commerce-heading p{color:#737b88;font-size:14px}.continue-shopping{display:flex;align-items:center;gap:12px;font-size:13px}.checkout-steps{display:flex;align-items:center;list-style:none;margin:37px 0 30px;padding:18px 0;border-top:1px solid #e9ebef;border-bottom:1px solid #e9ebef;gap:50px;color:#9ba1ab;font-size:12px}.checkout-steps li{display:flex;align-items:center;gap:11px}.checkout-steps li span{display:inline-flex;justify-content:center;align-items:center;height:25px;width:25px;border:1px solid #dbe0e7;border-radius:50%;font-size:10px}.checkout-steps .current{color:#147cff}.checkout-steps .current span{background:#147cff;border-color:#147cff;color:#fff}.empty-cart{padding:65px 20px 85px;text-align:center;background:#f6f7f9}.empty-icon{margin:0 auto 23px;width:85px;height:85px;background:#e8effa;color:#1677ff;display:flex;align-items:center;justify-content:center;border-radius:50%}.empty-cart h2{font-size:26px;margin-bottom:14px}.empty-cart p{font-size:13px;color:#7a828e;margin:0 0 27px}.empty-cart .button{background:#1677ff;border:0}.cart-table-head{display:grid;grid-template-columns:65px minmax(0,1fr) 135px 160px 140px;gap:22px;align-items:center;background:#f5f6f8;padding:18px 22px;font-size:12px;color:#818794}.select-all{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;font-size:12px}.select-all input,.item-selector input{width:16px;height:16px;accent-color:#1677ff;cursor:pointer}.cart-rows{border:1px solid #eceef2;border-top:0}.cart-row{display:grid;grid-template-columns:43px minmax(0,1fr) 135px 160px 140px;align-items:center;gap:22px;padding:24px 22px;border-bottom:1px solid #e9ebef}.cart-row:last-child{border:0}.cart-product{display:flex;align-items:center;gap:23px;min-width:0}.cart-photo{width:150px;min-width:150px;height:135px;background:#f4f5f7;display:flex;align-items:center;justify-content:center}.cart-photo img{width:100%;height:100%;object-fit:contain}.product-kind{color:#939ba7;font-size:10px}.cart-product h2{font-size:18px;font-weight:550;margin:5px 0 7px}.cart-product p{font-size:11px;color:#8a909b;margin-bottom:10px}.view-detail{display:flex;align-items:center;gap:6px;font-size:10px;color:#1677ff}.cart-unit-price{font-size:14px;font-variant-numeric:tabular-nums}.quantity-control{display:flex;border:1px solid #dce1e8;width:112px;height:35px}.quantity-control button{width:30px;background:#fff;color:#536070;font-size:17px}.quantity-control button:disabled{opacity:.3}.quantity-control input{border:0;border-left:1px solid #eceff3;border-right:1px solid #eceff3;text-align:center;min-width:0;width:50px;color:#151c29;-moz-appearance:textfield;font-size:12px}.quantity-control input::-webkit-outer-spin-button,.quantity-control input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}.cart-subtotal{display:flex;flex-direction:column;gap:14px;align-items:flex-end}.cart-subtotal strong{font-size:16px;font-variant-numeric:tabular-nums;font-weight:550}.remove-item,.remove-selected{color:#949aa5;background:transparent;font-size:11px;padding:0}.remove-item:hover,.remove-selected:hover{color:#ec4c4c}.cart-bottom-note{display:flex;align-items:center;gap:8px;color:#8a929e;font-size:11px;padding:20px 0}.cart-checkout-bar{position:sticky;bottom:0;z-index:9;background:#fff;border:1px solid #e6eaf0;box-shadow:0 -6px 20px #1e3c6408;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:19px 24px}.cart-checkout-bar>div:first-child{display:flex;align-items:center;gap:25px}.selected-count{color:#818895;font-size:12px}.selected-count strong{color:#1677ff}.checkout-total{display:flex;align-items:center;gap:30px}.checkout-total>span{font-size:12px;color:#747d8a}.checkout-total strong{font-size:28px;font-weight:550;margin-left:14px;color:#161b26}.checkout-total small{display:block;text-align:right;color:#929aa6;font-size:10px}.checkout-total .button{background:#1677ff;border:0;min-width:158px;min-height:52px}.cart-live{font-size:12px;color:#818895;min-height:25px;margin-top:12px}.mobile-label{display:none}.commerce-assurance{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;border-top:1px solid #e7ebf0;padding-top:37px;margin-top:43px}.commerce-assurance>div{display:grid;grid-template-columns:35px 1fr;column-gap:14px;align-items:center}.commerce-assurance :global(svg){grid-row:1/3;color:#1677ff}.commerce-assurance strong{font-size:13px;font-weight:500}.commerce-assurance span{grid-column:2;font-size:11px;color:#98a0ac;margin-top:4px}@media(max-width:1100px){.cart-table-head{grid-template-columns:45px minmax(0,1fr) 105px 125px 100px;gap:13px}.cart-row{grid-template-columns:30px minmax(0,1fr) 105px 125px 100px;gap:13px}.cart-photo{width:110px;min-width:110px;height:115px}.cart-product{gap:16px}.cart-product h2{font-size:15px}}@media(max-width:760px){.cart-page{padding-top:108px}.commerce-heading h1{font-size:30px}.commerce-heading p{font-size:12px}.continue-shopping{font-size:10px;gap:5px}.checkout-steps{gap:24px;margin-top:26px;font-size:10px}.cart-table-head{display:flex}.cart-table-head>span{display:none}.cart-row{position:relative;display:grid;grid-template-columns:22px 1fr 105px;gap:14px;padding:20px 14px}.item-selector{grid-row:1}.cart-product{grid-column:2/4;align-items:center;gap:15px}.cart-photo{width:88px;min-width:88px;height:96px}.cart-product h2{font-size:16px}.cart-product p{font-size:10px}.cart-unit-price{grid-column:2;font-size:12px}.mobile-label{display:inline;color:#8f97a3;font-size:10px;margin-right:9px}.quantity-control{grid-column:3;grid-row:2;width:105px}.cart-subtotal{grid-column:2/4;flex-direction:row;justify-content:space-between;align-items:center;gap:8px}.cart-subtotal strong{font-size:16px;margin-right:auto}.cart-bottom-note{font-size:10px;line-height:1.8;align-items:flex-start}.cart-bottom-note svg{flex-shrink:0;margin-top:3px}.cart-checkout-bar{padding:16px 13px;align-items:center;gap:9px}.cart-checkout-bar>div:first-child{gap:10px}.remove-selected,.selected-count{display:none}.checkout-total{gap:12px}.checkout-total>span{font-size:10px}.checkout-total strong{font-size:21px;margin-left:3px;display:block;text-align:right}.checkout-total small{display:none}.checkout-total .button{min-width:110px;min-height:47px;padding:10px 16px;gap:9px;font-size:12px}.commerce-assurance{grid-template-columns:1fr;gap:25px;margin-top:30px}.empty-cart{padding:50px 20px}.empty-cart h2{font-size:23px}.breadcrumb{margin-bottom:25px}}
  </style>
</Layout>
