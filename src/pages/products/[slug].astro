---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, families, formatPrice, type Product } from '../../data/catalog';

export function getStaticPaths() {
  return products.map(product => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props as { product: Product };
const isRobot = product.kind === 'robot';
const titleParts = isRobot ? product.name.match(/^(.+?)([\u3400-\u9fff].*)$/) : null;
const family = families.find(item => item.slug === product.family);
const variants = products.filter(item => item.family === product.family && item.kind === product.kind);
const comparison = variants.length > 1 ? [...variants.filter(item => item.slug === product.slug), ...variants.filter(item => item.slug !== product.slug)].slice(0,4) : [product];
const accessories = product.relatedAccessories.map(slug => products.find(item => item.slug === slug)).filter(Boolean) as Product[];
const related = products.filter(item => item.kind === product.kind && item.slug !== product.slug && item.family !== product.family).slice(0,3);
const productImage = isRobot ? product.image.replace(/\.jpg$/, '-cutout.png') : product.image;
const gallery = [...new Set([productImage, ...product.gallery.map(image => isRobot ? image.replace(/\.jpg$/, '-cutout.png') : image)])];
const specValue = (label: string) => product.specs.find(row => row.label === label)?.value || '按配置确认';
const heroStats = isRobot ? [
  product.keyStats.find(stat => stat.label === '移动速度'),
  { label: '关节最大扭矩', value: specValue('关节最大扭矩') },
  product.keyStats.find(stat => stat.label === '带电池重量'),
  product.keyStats.find(stat => stat.label === '任务载荷'),
  { label: '跨越台阶', value: specValue('台阶高度示例') },
  product.keyStats.find(stat => stat.label === '续航示例'),
].filter(Boolean) as {label:string;value:string}[] : product.keyStats;
const featureCopy = isRobot ? [
  { title: '智能感知', label: 'PERCEPTION', icon: 'eye', text: '将环境变成可理解的信息。结合当前配置的感知模组，建立从采集、识别到运动决策的完整链路。' },
  { title: '全身协同', label: 'MOTION CONTROL', icon: 'terrain', text: '让每一个关节配合每一步运动。在多种地面与任务中，以灵活的四足结构探索更丰富的运动方式。' },
  { title: '开放扩展', label: 'EXPAND YOUR IDEAS', icon: 'code', text: '把你的想法接入真实平台。按版本选择开发接口、计算资源与外设，让创造力拥有持续生长的空间。' },
] : [
  { title: '匹配你的平台', label: 'COMPATIBILITY', icon: 'check', text: '从型号与接口出发确认适配关系。为已有的机器狗补齐能力，让每一个扩展都更有目的。' },
  { title: '模块化组合', label: 'MODULAR SYSTEM', icon: 'code', text: '按实际任务选择电源、感知或执行部件，组合更完整的机器人配置，拓展平台的应用边界。' },
  { title: '从安装到使用', label: 'READY FOR YOUR MISSION', icon: 'shield', text: '结合产品规格、安装方式与软件要求完成配置检查。相关使用条件请在正式采购时逐项确认。' },
];
const calloutLabels = isRobot ? ['前置感知模组', '多关节运动系统', '外置扩展接口', '智能电源系统'] : ['硬件适配', '连接与安装', '功能拓展', '配置兼容'];
const calloutValues = isRobot ? [specValue('感知组合'), specValue('驱动结构'), specValue('扩展接口'), specValue('电池组合示例')] : [product.category, product.features[0], product.features[1], product.features[2]];
const scenarioPath = (useCase: string) => /教学|课程|高校|教育/.test(useCase) ? '/solutions/education/' : /巡检|巡查|现场|设备|园区|路线/.test(useCase) ? '/solutions/inspection/' : /科研|研究|算法|SLAM|开发|实验/.test(useCase) ? '/solutions/research/' : /运输|物料|载荷/.test(useCase) ? '/solutions/logistics/' : /展示|展厅|展会|活动|品牌|体验|科技/.test(useCase) ? '/solutions/exhibition/' : '/solutions/';
const schema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.robotdog.com/' },
    { '@type': 'ListItem', position: 2, name: '产品系列', item: 'https://www.robotdog.com/products/' },
    { '@type': 'ListItem', position: 3, name: product.name, item: `https://www.robotdog.com/products/${product.slug}/` },
  ],
};
---
<Layout title={product.seoTitle} description={product.seoDescription} schema={schema}>
  <section class="detail-hero" id="overview">
    <div class="detail-hero-grid container">
      <div class="detail-hero-copy">
        <nav class="detail-breadcrumb" aria-label="面包屑导航"><a href="/">首页</a><span>/</span><a href="/products/">产品系列</a><span>/</span><span>{product.name}</span></nav>
        <span class="detail-eyebrow">{isRobot ? 'QUADRUPED ROBOTICS' : 'ROBOTICS ACCESSORIES'} / {family?.name || product.category}</span>
        <h1>{titleParts ? <>{titleParts[1]}<span class="hero-config-name">{titleParts[2]}</span></> : product.name}</h1><h2>{product.tagline}</h2><p class="detail-description">{product.description}</p>
        <div class="detail-price"><strong>{formatPrice(product.priceCNY)}</strong><span>展示价</span></div>
        <div class="detail-buy-actions"><button class="button button-blue" data-buy-now={product.slug}>立即选购 <Icon name="arrow" size={19}/></button><button class="detail-add-cart" data-add-to-cart={product.slug}><Icon name="cart" size={20}/>加入购物车</button></div>
        <p class="detail-preview-notice">选型展示版 · 价格与参数为展示参考，正式配置及报价以采购确认信息为准。</p>
      </div>
      <div class="detail-hero-visual"><span class="hero-model-watermark" aria-hidden="true">{family?.name || 'ROBOTDOG'}</span><div class="detail-image-stage"><img id="detail-main-image" src={productImage} alt={`${product.name} ${isRobot ? '四足机器狗' : '配件'}产品外观`} width="1000" height="850" fetchpriority="high"/></div><span class="visual-axis axis-one" aria-hidden="true"></span><span class="visual-axis axis-two" aria-hidden="true"></span><div class="visual-bottom-caption"><span>ENGINEERED TO MOVE FORWARD</span><span>{product.tier || product.englishName}</span></div>{gallery.length > 1 && <div class="detail-gallery" role="group" aria-label="查看产品图片">{gallery.map((image,index) => <button class:list={['gallery-button', { active: index === 0 }]} data-gallery-image={image} aria-label={`查看 ${product.name} 第 ${index + 1} 张图片`} aria-pressed={index === 0 ? 'true' : 'false'}><img src={image} alt="" width="100" height="82" loading="lazy"/></button>)}</div>}</div>
    </div>
    <div class="key-stat-grid container" style={`--stat-count:${heroStats.length}`}>{heroStats.map(stat => <div><span>{stat.label}</span><strong>{stat.value}</strong></div>)}</div>
  </section>
  <nav class="detail-section-nav" aria-label="产品介绍内容导航"><div class="container"><span>{product.name}</span><div><a href="#overview">产品概览</a><a href="#features">功能配置</a><a href="#specifications">技术参数</a><a href="#accessories">配件与套装</a></div><button class="button button-blue button-small" data-add-to-cart={product.slug}><Icon name="cart" size={16}/>加入购物车</button></div></nav>
  <section class="detail-features" id="features"><div class="container"><div class="detail-section-heading"><span class="detail-eyebrow">BUILT FOR EVERY NEXT STEP</span><h2>精密之内，<br/>是更广阔的可能。</h2><p>{product.shortDescription}</p></div><div class="feature-machine"><div class="feature-machine-orbit" aria-hidden="true"></div><img src={productImage} alt={`${product.name} 功能配置展示`} width="900" height="800" loading="lazy"/>{calloutLabels.map((label,index) => <div class:list={['feature-callout', `callout-${index+1}`]}><span class="callout-line" aria-hidden="true"></span><span class="callout-index">0{index+1}</span><h3>{label}</h3><p>{calloutValues[index] || product.shortDescription}</p></div>)}</div><div class="detail-feature-cards">{featureCopy.map((feature,index) => <div><div class="feature-card-top"><Icon name={feature.icon} size={25}/><span>0{index+1}</span></div><span class="feature-card-label">{feature.label}</span><h3>{feature.title}</h3><p>{feature.text}</p></div>)}</div></div></section>
  <section class="detail-configure container" id="configuration"><div class="detail-section-heading"><span class="detail-eyebrow">CONFIGURE YOUR POSSIBILITIES</span><h2>不同配置，同一种向前。</h2><p>{variants.length > 1 ? '选择适合你的版本，查看对应价格、硬件与软件配置。' : '先确认适配型号，再组合你的完整产品方案。'}</p></div><div class="configuration-layout"><div class="configuration-visual"><img src={productImage} alt={`${product.name} 配置选择`} width="900" height="760" loading="lazy"/><span>{product.englishName}</span></div><div class="configuration-copy"><span class="config-label">{family?.name || product.category} / 选择版本</span><div class="variant-options">{variants.map(item => <a class:list={['variant-option', { selected: item.slug === product.slug }]} href={`/products/${item.slug}/`} aria-current={item.slug === product.slug ? 'page' : undefined}><span>{item.tier || item.name}</span><strong>{formatPrice(item.priceCNY)}</strong>{item.slug === product.slug && <Icon name="check" size={16}/>}</a>)}</div><h3>{product.name}</h3><p>{product.positioning}</p><div class="configuration-tags">{product.features.map(feature => <span><Icon name="check" size={14}/>{feature}</span>)}</div><div class="config-total"><span>当前选择 · 展示价格</span><strong>{formatPrice(product.priceCNY)}</strong></div><div class="config-actions"><button class="button button-blue" data-buy-now={product.slug}>立即选购 <Icon name="arrow" size={18}/></button><button class="button button-outline" data-add-to-cart={product.slug}><Icon name="cart" size={19}/>加入购物车</button></div></div></div></section>
  <section class="detail-specifications" id="specifications"><div class="container"><div class="detail-section-heading"><span class="detail-eyebrow">PRECISION IN EVERY DETAIL</span><h2>了解每一项技术细节。</h2><p>配置参数为选型展示参考；不同版本、配件及软件更新可能影响实际表现，以正式配置文件为准。</p></div><div class="specification-scroll" role="region" aria-label="机器狗配置参数对比表" tabindex="0"><table class="specification-table"><thead><tr><th scope="col" class="spec-label-heading">型号 / 配置</th>{comparison.map(item => <th scope="col" class:list={[{ 'current-spec-column': item.slug === product.slug }]}><a href={`/products/${item.slug}/`}>{item.name}</a><span>{item.slug === product.slug ? '当前配置' : item.tier}</span><strong>{formatPrice(item.priceCNY)}</strong></th>)}</tr></thead><tbody>{product.specificationGroups.map(group => <><tr class="spec-group-row"><th colspan={comparison.length+1}>{group.name}</th></tr>{group.rows.map(row => <tr><th scope="row">{row.label}</th>{comparison.map(item => <td class:list={[{ 'current-spec-column': item.slug === product.slug }]}>{item.specificationGroups.find(variantGroup => variantGroup.name === group.name)?.rows.find(variantRow => variantRow.label === row.label)?.value || '按配置确认'}</td>)}</tr>)}</>)}</tbody><tfoot><tr><th scope="row">选择配置</th>{comparison.map(item => <td class:list={[{ 'current-spec-column': item.slug === product.slug }]}><button data-add-to-cart={item.slug}><Icon name="cart" size={16}/>加入购物车</button></td>)}</tr></tfoot></table></div><p class="specification-footnote">实际速度、续航、载荷和环境适应性与版本及测试工况有关。请在采购前确认具体型号、接口、传感器、软件和适配清单。</p></div></section>
  <section class="detail-box container" id="accessories"><div class="detail-section-heading"><span class="detail-eyebrow">YOUR COMPLETE ROBOTICS KIT</span><h2>{isRobot ? '完整装备，让每一步就绪。' : '了解包装与适配要求。'}</h2><p>基础套装与选配扩展，一次看清。</p></div><div class="inbox-layout"><div class="inbox-picture"><img src={productImage} alt={`${product.name} 基础套装中的主要产品`} width="750" height="650" loading="lazy"/><span>IN THE BOX</span></div><div class="inbox-copy"><span class="detail-eyebrow">标准包装内容</span><h3>{product.name}<br/>基础套装</h3><ul>{product.inBox.map((item,index) => <li><span>0{index+1}</span>{item}<Icon name="check" size={16}/></li>)}</ul><p>包装清单为展示参考；请以正式确认的采购配置及随箱文件为准。</p></div></div>{accessories.length > 0 && <div class="detail-accessories"><div class="detail-accessory-heading"><h3>为你的机器狗，拓展新能力。</h3><a href="/products/?family=accessories">全部配件 <Icon name="arrow" size={17}/></a></div><div class="accessory-cards">{accessories.map(item => <ProductCard product={item} compact/>)}</div></div>}</section>
  <section class="detail-usecases"><div class="container"><span class="detail-eyebrow">FROM POSSIBILITIES TO REAL MISSIONS</span><h2>让能力，走进真实场景。</h2><div class="usecase-pills">{product.useCases.map(useCase => <a href={scenarioPath(useCase)}>{useCase}<Icon name="diagonal" size={15}/></a>)}</div><a class="button button-blue" href="/solutions/">探索应用场景 <Icon name="arrow" size={18}/></a></div></section>
  <section class="detail-related container"><div class="detail-accessory-heading"><div><span class="detail-eyebrow">KEEP EXPLORING</span><h2>发现更多可能。</h2></div><a href="/products/">全部产品 <Icon name="arrow" size={17}/></a></div><div class="related-products">{related.map(item => <ProductCard product={item}/>)}</div></section>
  <script>
    const mainImage = document.querySelector<HTMLImageElement>('#detail-main-image');
    const galleryButtons = document.querySelectorAll<HTMLButtonElement>('[data-gallery-image]');
    galleryButtons.forEach(button => button.addEventListener('click', () => {
      if(mainImage && button.dataset.galleryImage) mainImage.src = button.dataset.galleryImage;
      galleryButtons.forEach(item => { item.classList.toggle('active',item === button); item.setAttribute('aria-pressed',String(item === button)); });
    }));
  </script>
</Layout>
<style>
  .detail-hero{background:#05070c;color:white;padding:118px 0 50px;position:relative;overflow:hidden}.detail-hero-grid{display:grid;grid-template-columns:1fr 1.07fr;gap:36px;align-items:center}.detail-hero-copy{position:relative;z-index:2;padding:18px 0 29px}.detail-breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-size:9px;color:#a2a9b8;margin-bottom:36px}.detail-breadcrumb a:hover{color:white}.detail-eyebrow{display:block;font-size:9px;letter-spacing:1.6px;color:#8f9bbe;line-height:1.6}.detail-hero h1{font-size:clamp(38px,4.6vw,67px);font-weight:600;letter-spacing:-2.2px;line-height:1.08;margin:15px 0 24px}.hero-config-name{display:block;font-size:clamp(20px,2vw,28px);font-weight:450;letter-spacing:-.4px;line-height:1.5;color:#a7b3cc;margin-top:12px}.detail-hero h2{font-size:23px;font-weight:450;color:#e1e4ed;line-height:1.6;letter-spacing:-.5px}.detail-description{font-size:12px;line-height:1.95;color:#9ea7bb;max-width:440px;margin:16px 0 23px}.detail-price{display:flex;align-items:center;gap:11px;margin:0 0 21px}.detail-price strong{font-size:28px;line-height:1.4;letter-spacing:-.7px;font-weight:600}.detail-price span{font-size:10px;color:#969fb3;background:#ffffff10;border:1px solid #ffffff1b;padding:2px 7px}.detail-buy-actions{display:flex;gap:18px;align-items:center;flex-wrap:wrap}.detail-buy-actions .button{font-size:12px;padding:11px 22px;gap:24px}.detail-add-cart{background:transparent;border:1px solid #5b6274;color:#e3e8f5;padding:11px 18px;display:flex;align-items:center;justify-content:center;gap:12px;font-size:12px;min-height:49px}.detail-add-cart:hover{background:#ffffff12}.detail-preview-notice{font-size:9px;color:#737f99;line-height:1.8;margin-top:18px;max-width:440px}.detail-hero-visual{position:relative;min-width:0;display:flex;flex-direction:column;align-items:center;isolation:isolate}.hero-model-watermark{font-size:clamp(78px,11vw,150px);font-weight:750;line-height:1;letter-spacing:-9px;position:absolute;top:0;left:0;right: