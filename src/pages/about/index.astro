---
import { siteUrl } from '../../config/site';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
const values = [
  { icon: 'eye', name: '让产品清晰可见', label: 'CLEAR INFORMATION', text: '把机型定位、版本差异、关键参数和选配附件放在一起。无论是第一次了解玩具机器人车，还是准备一个课堂项目，都能从具体信息开始判断。' },
  { icon: 'code', name: '让创新有处着陆', label: 'IDEAS INTO ACTION', text: '关注接口、数据和计算配置，也关注仿真与实机之间的连接。让家庭、课堂和创客活动找到合适的套装，让每一步迭代都有可比较的依据。' },
  { icon: 'terrain', name: '让技术回应场景', label: 'PURPOSEFUL MOTION', text: '先理解任务，再选择配置。把路线、年龄、课程目标和使用条件放进讨论，用有代表性的实验判断技术与场景的适配程度。' },
  { icon: 'shield', name: '让合作更有依据', label: 'A CLEAR WAY FORWARD', text: '把选型、演示、配置确认和交付安排拆成清晰步骤。用能说明白的清单和验证结果，帮助项目从兴趣走向实践。' },
];
const steps = [
  { icon: 'eye', title: '听见你的目标', label: 'UNDERSTAND', text: '从使用目的开始，了解场地、任务、接口与预算。把“想要一台玩具机器人车”，变成可以讨论的应用需求。', items: ['场景与目标', '预算与计划'] },
  { icon: 'code', title: '找到合适配置', label: 'CONFIGURE', text: '一起比较候选机型与版本，梳理传感器、算力、电池和配件。让报价对应一份明确的配置清单。', items: ['机型与版本', '附件与兼容'] },
  { icon: 'terrain', title: '让方案接受验证', label: 'VALIDATE', text: '围绕代表性任务核对开发接口和现场条件。通过演示或试点，把参数表中的信息放回真实使用过程。', items: ['接口与场地', '验收与试点'] },
  { icon: 'shield', title: '规划长期使用', label: 'SUPPORT', text: '在方案确认后，讨论商品确认、交付、玩法资料和维护安排。关注设备投入使用后，人员、软件和日常管理如何衔接。', items: ['交付与培训', '维护与升级'] },
];
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
  { '@type': 'ListItem', position: 2, name: '关于 RobotCar', item: `${siteUrl}/about/` },
] };
---
<Layout title="关于 RobotCar｜连接智能玩具车、真实应用与未来探索" description="认识 RobotCar 的产品选型与应用理念，探索智能玩具车、车载智能和创意场景，了解配置沟通、验证与交付规划的服务流程。" schema={schema}>
  <section class="brand-hero"><img src="/images/scenes/workshop.webp" alt="充满未来感的机器人展示与交流空间概念画面" width="1536" height="1024" fetchpriority="high"/><div class="brand-hero-shade"></div><div class="brand-hero-copy"><span>ROBOTCAR / ALWAYS MOVING FORWARD</span><h1>让玩乐，<br/>驶向更多可能。</h1><p>把前沿科技带到眼前，<br/>把每一个想法，连接到真实世界。</p><a href="#perspective">认识 RobotCar <Icon name="arrow" size={18}/></a></div><span class="brand-hero-caption">OUR VISION / TECHNOLOGY WITH A PURPOSE</span></section>
  <section class="container brand-story" id="perspective"><div><span class="brand-kicker">WHO WE ARE</span><h2>我们相信，<br/>技术的下一步，<br/>应该离每个人更近。</h2><span class="brand-story-word">ROBOTCAR</span></div><div class="brand-story-copy"><p class="brand-lead">一辆小小的玩具车，可以是亲子时光里的欢乐，也可以是课堂上的一个问题、创客桌上的一次发现。让大家亲手操控、搭建和编程，是我们理解科技的方式。</p><p>RobotCar 希望成为了解与选购智能玩具车的清晰入口。我们把产品系列、配置参数、配件组合和应用方向放在同一个视野里，帮助你从“这辆小车很有趣”，走到“它是否适合我的玩法”。</p><p>遥控竞速、编程学习和亲子搭建，需要不同的套装。我们关注操控体验，也关注适龄标识、电池、控制板和配件兼容；把每一个选择讲清楚，让第一次体验和后续拓展都有方向。</p><p>从产品认知到方案沟通，清晰的信息是一切合作的起点。让技术更容易被理解，让选择更有依据，让想法拥有行动的载体，这就是 RobotCar 希望带来的价值。</p><a href="/products/">发现产品系列 <Icon name="diagonal" size={18}/></a></div></section>
  <section class="brand-values"><div class="container"><div class="brand-section-heading"><span class="brand-kicker">WHAT GUIDES US</span><h2>不止看见精彩，<br/>更看见下一步的价值。</h2></div><div class="brand-value-grid">{values.map((value, index) => <article><div class="brand-value-top"><Icon name={value.icon} size={34}/><span>0{index + 1}</span></div><span class="brand-value-label">{value.label}</span><h3>{value.name}</h3><p>{value.text}</p></article>)}</div></div></section>
  <section class="container brand-picture-story"><div class="brand-picture"><img src="/images/scenes/workshop.webp" alt="智能玩具车在教学与研发空间中的概念场景" width="1536" height="1024" loading="lazy"/><span>FROM IDEAS TO REAL-WORLD EXPERIMENTS</span></div><div class="brand-picture-copy"><span class="brand-kicker">A CONNECTION THAT MATTERS</span><h2>连接产品与应用，<br/>连接今天与未来。</h2><p>一辆玩具机器人车，连接车轮、感知、计算和创意。一个有价值的应用，则把这些能力连接到具体的人与任务。</p><p>我们希望让产品展示成为思考的入口：在教育里，帮助知识形成可观察的实验；在研发中，帮助想法获得真实反馈；在家庭和课堂，帮助大家把玩法、程序与学习目标连接起来。</p><p>在“探索与未来”，我们也关注车载智能、世界模型、空间智能与边缘计算。把前沿方向讲清楚，让未来的想象与今天的实践保持联系。</p><div><a href="/solutions/">发现应用场景 <Icon name="diagonal" size={17}/></a><a href="/journal/">走进探索与未来 <Icon name="diagonal" size={17}/></a></div></div></section>
  <section class="brand-mission"><img src="/images/scenes/race.webp" alt="智能玩具车在广阔户外环境中的探索概念画面" width="1536" height="1024" loading="lazy"/><div class="brand-mission-shade"></div><div><span class="brand-kicker">OUR VISION</span><h2>每一次向前，<br/>都让未来更近一点。</h2><p>保留好奇，保持清晰。<br/>让精彩的技术，回应值得解决的问题。</p></div></section>
  <section class="container brand-process" id="process"><div class="brand-process-heading"><div><span class="brand-kicker">A CLEAR PATH FORWARD</span><h2>从想法到实践，<br/>让每一步有迹可循。</h2></div><button data-inquiry>开始选型沟通 <Icon name="diagonal" size={18}/></button></div><div class="brand-process-grid">{steps.map((step, index) => <article><div class="brand-process-top"><span>0{index + 1}</span><Icon name={step.icon} size={26}/></div><span class="brand-process-label">{step.label}</span><h3>{step.title}</h3><p>{step.text}</p><ul>{step.items.map((item) => <li><Icon name="check" size={14}/>{item}</li>)}</ul></article>)}</div></section>
  <section class="brand-questions"><div class="container brand-question-inner"><div><span class="brand-kicker">BEFORE YOUR NEXT STEP</span><h2>关于开始，<br/>你可能还想知道。</h2><p>好的沟通，从把问题问清楚开始。</p></div><div class="brand-faq"><details><summary>我第一次购买玩具机器人车，应该准备什么？<Icon name="plus" size={19}/></summary><p>先说明参与者年龄、使用场地和喜欢的玩法，再提供预算与数量。是否需要编程、相机或积木拓展，也会影响套装和配件选择。你可以先阅读<a href="/journal/how-to-choose-a-robot-car/">玩具机器人车选型指南</a>，或通过咨询入口整理需求。</p></details><details><summary>产品与配件可以怎样组合？<Icon name="plus" size={19}/></summary><p>从机型、版本和任务开始，分别核对电池、充电设备、传感器、计算模块和扩展附件。兼容性涉及机械安装、供电、接口和软件版本，需要以对应机型与最终配置清单确认。<a href="/products/">产品系列</a>可以帮助你先比较方向。</p></details><details><summary>如何选择适合家庭或课堂的套装？<Icon name="plus" size={19}/></summary><p>先说明参与者年龄、编程经验、使用场地与希望完成的玩法。遥控车适合直接体验，编程车适合传感器与代码项目。核对适龄标识、包装清单和教学支持后，再选择对应的套装。</p></details><details><summary>报价与交付前需要确认哪些内容？<Icon name="plus" size={19}/></summary><p>报价应对应明确的型号、版本、附件、软件与服务清单，并说明税费、运输、交付周期、验收与维护安排。页面价格与配置用于当前选型展示，实际采购内容以正式确认的方案与合同为准。</p></details></div></div></section>
</Layout>
<style>
  .brand-hero{position:relative;height:720px;margin-top:80px;background:#08101e;color:#fff;overflow:hidden}.brand-hero>img,.brand-hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.brand-hero-shade{background:linear-gradient(0deg,#020918d6,#0209182c 95%),linear-gradient(90deg,#02091850,#02091820)}.brand-hero-copy{position:relative;text-align:center;padding:170px 24px 0;z-index:1}.brand-hero-copy>span{font-size:12px;letter-spacing:.2em;color:#afc7ec}.brand-hero h1{font-size:clamp(46px,5vw,73px);font-weight:600;letter-spacing:-.035em;line-height:1.27;margin:30px 0 25px}.brand-hero-copy>p{font-size:18px;line-height:1.9;color:#d4dfed;margin:0 0 33px}.brand-hero-copy>a{display:inline-flex;align-items:center;gap:24px;padding:14px 26px;background:#1674ff;font-size:14px}.brand-hero-caption{position:absolute;left:6%;bottom:32px;font-size:10px;letter-spacing:.13em;color:#afc2df}.brand-kicker{font-size:11px;letter-spacing:.15em;color:#1674ff;font-weight:600}.brand-story{display:grid;grid-template-columns:1fr 1.2fr;gap:100px;padding:95px 0;scroll-margin-top:100px}.brand-story h2{font-size:clamp(32px,3.2vw,47px);line-height:1.4;letter-spacing:-.03em;margin:24px 0 32px}.brand-story-word{font-size:36px;color:#e3e8ef;letter-spacing:.08em;font-weight:700}.brand-story-copy p{font-size:15px;line-height:2;color:#6b7788;margin:0 0 23px}.brand-story-copy p.brand-lead{font-size:20px;line-height:1.85;color:#26394f}.brand-story-copy>a{display:inline-flex;align-items:center;gap:20px;margin-top:13px;font-size:13px;color:#1674ff}.brand-values{padding:85px 0;background:#f5f7fa}.brand-section-heading h2{font-size:40px;line-height:1.4;letter-spacing:-.025em;margin:22px 0 43px}.brand-value-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.brand-value-grid article{padding:30px;background:#fff}.brand-value-top{display:flex;justify-content:space-between;align-items:center;color:#1674ff;margin-bottom:33px}.brand-value-top>span{font-size:10px;color:#a5b1c3}.brand-value-label{font-size:9px;color:#9ba6b7;letter-spacing:.08em}.brand-value-grid h3{font-size:22px;margin:15px 0 18px;line-height:1.5;letter-spacing:-.025em}.brand-value-grid p{font-size:13px;line-height:1.95;color:#748093}.brand-picture-story{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:70px;padding:95px 0}.brand-picture{position:relative;aspect-ratio:1.05;overflow:hidden;background:#0b1422}.brand-picture>img{width:100%;height:100%;object-fit:cover}.brand-picture:after{content:'';position:absolute;inset:55% 0 0;background:linear-gradient(transparent,#020b18b3)}.brand-picture>span{position:absolute;left:27px;bottom:27px;z-index:1;color:#dbe5f5;font-size:9px;letter-spacing:.08em}.brand-picture-copy h2{font-size:37px;line-height:1.4;letter-spacing:-.025em;margin:23px 0}.brand-picture-copy p{font-size:14px;line-height:2;color:#6e7b8e;margin:0 0 19px}.brand-picture-copy>div{display:flex;flex-wrap:wrap;gap:25px;margin-top:27px}.brand-picture-copy a{display:flex;align-items:center;gap:14px;color:#1674ff;font-size:12px}.brand-mission{position:relative;min-height:610px;display:flex;justify-content:center;align-items:center;color:#fff;background:#070d17;text-align:center;overflow:hidden}.brand-mission>img,.brand-mission-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.brand-mission-shade{background:#020917a8}.brand-mission>div:last-child{position:relative;padding:80px 25px}.brand-mission .brand-kicker{color:#a7c7fa}.brand-mission h2{font-size:clamp(35px,4.5vw,63px);line-height:1.35;letter-spacing:-.03em;margin:28px 0}.brand-mission p{font-size:17px;line-height:1.95;color:#c6d5e9}.brand-process{padding:95px 0;scroll-margin-top:100px}.brand-process-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:45px}.brand-process-heading h2{font-size:38px;line-height:1.4;letter-spacing:-.025em;margin:22px 0 0}.brand-process-heading>button{display:flex;align-items:center;gap:20px;background:#1674ff;color:#fff;padding:15px 23px;font-size:13px}.brand-process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px}.brand-process-grid article{padding-top:23px;border-top:2px solid #1674ff}.brand-process-top{display:flex;justify-content:space-between;align-items:center;color:#1674ff;margin-bottom:25px}.brand-process-top>span{font-size:31px}.brand-process-label{font-size:9px;color:#9aa6b7;letter-spacing:.1em}.brand-process-grid h3{font-size:21px;line-height:1.5;margin:16px 0}.brand-process-grid p{font-size:13px;line-height:1.95;color:#758297;min-height:100px}.brand-process-grid ul{list-style:none;padding:20px 0 0;display:flex;flex-direction:column;gap:10px;border-top:1px solid #e4e9f1;margin-top:20px}.brand-process-grid li{display:flex;align-items:center;gap:10px;font-size:11px;color:#5f728e}.brand-process-grid li svg{color:#1674ff}.brand-questions{padding:85px 0;background:#f5f7fa}.brand-question-inner{display:grid;grid-template-columns:1fr 1.3fr;gap:100px;align-items:start}.brand-question-inner h2{font-size:36px;line-height:1.45;letter-spacing:-.025em;margin:22px 0}.brand-question-inner>div:first-child>p{font-size:13px;color:#8490a2}.brand-faq{border-top:1px solid #dce4ed}.brand-faq details{border-bottom:1px solid #dce4ed}.brand-faq summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 0;font-size:15px;cursor:pointer;line-height:1.7}.brand-faq summary::-webkit-details-marker{display:none}.brand-faq summary svg{flex-shrink:0;color:#1674ff;transition:transform .25s}.brand-faq details[open] summary svg{transform:rotate(45deg)}.brand-faq details>p{font-size:13px;line-height:2;color:#748296;margin:0 0 25px;padding-right:35px}.brand-faq p a{color:#1674ff;text-decoration:underline}
  @media(max-width:1050px){.brand-value-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.brand-story,.brand-question-inner{gap:50px}.brand-picture-story{gap:40px}.brand-picture-copy h2{font-size:31px}.brand-process-grid{gap:22px}.brand-process-grid h3{font-size:19px}}
  @media(max-width:640px){.brand-hero{height:620px;margin-top:68px}.brand-hero>img{object-position:60% 50%}.brand-hero-copy{padding:140px 20px 0}.brand-hero-copy>span{font-size:9px;letter-spacing:.12em}.brand-hero h1{font-size:46px;margin:26px 0}.brand-hero-copy>p{font-size:14px;margin-bottom:29px}.brand-hero-copy>a{font-size:12px;padding:13px 23px;gap:20px}.brand-hero-caption{left:20px;bottom:27px;font-size:8px;letter-spacing:.08em}.brand-kicker{font-size:9px}.brand-story{grid-template-columns:1fr;gap:25px;padding:55px 0}.brand-story h2{font-size:32px;line-height:1.45;margin-bottom:20px}.brand-story-word{display:none}.brand-story-copy p.brand-lead{font-size:18px}.brand-story-copy p{font-size:14px;line-height:1.95}.brand-story-copy>a{font-size:12px}.brand-values{padding:55px 0}.brand-section-heading h2{font-size:30px;margin:20px 0 30px}.brand-value-grid{grid-template-columns:1fr;gap:15px}.brand-value-grid article{padding:27px}.brand-value-top{margin-bottom:25px}.brand-value-grid h3{font-size:23px;margin:13px 0 16px}.brand-value-grid p{font-size:13px}.brand-picture-story{grid-template-columns:1fr;gap:30px;padding:55px 0}.brand-picture{aspect-ratio:1.2}.brand-picture>span{font-size:8px;left:20px;bottom:22px}.brand-picture-copy h2{font-size:30px}.brand-picture-copy p{font-size:13px}.brand-picture-copy>div{gap:20px}.brand-picture-copy a{font-size:11px;gap:10px}.brand-mission{min-height:480px}.brand-mission h2{font-size:38px}.brand-mission p{font-size:13px}.brand-process{padding:55px 0}.brand-process-heading{align-items:start;flex-direction:column;gap:25px;margin-bottom:35px}.brand-process-heading h2{font-size:30px}.brand-process-heading>button{font-size:12px;padding:13px 20px}.brand-process-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 20px}.brand-process-top>span{font-size:27px}.brand-process-grid h3{font-size:18px}.brand-process-grid p{font-size:12px;min-height:0}.brand-process-grid li{font-size:10px;gap:6px}.brand-questions{padding:55px 0}.brand-question-inner{grid-template-columns:1fr;gap:25px}.brand-question-inner h2{font-size:30px}.brand-faq summary{font-size:13px;padding:20px 0}.brand-faq details>p{font-size:12px;padding-right:0}}
</style>
