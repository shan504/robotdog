---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/catalog';
import { articles } from '../data/articles';
const featured = ['go2-air','as2-air','b2-standard','go2w-standard'].map(slug=>products.find(p=>p.slug===slug)).filter(Boolean);
const schema = { '@context':'https://schema.org','@type':'Organization',name:'RobotDog',url:'https://robotdogcxy.xyz',logo:'https://robotdogcxy.xyz/favicon.svg' };
const categories = [{name:'消费与科研',en:'EVERYDAY INTELLIGENCE',description:'让好奇成为日常，让想法走出实验室。',href:'/products/?family=go2',image:'/images/catalog/go2.jpg'},{name:'行业与巡检',en:'BUILT FOR THE REAL WORLD',description:'从复杂地形到真实任务，为现场寻找新解法。',href:'/products/?family=b2',image:'/images/catalog/b2.jpg'},{name:'配件与拓展',en:'EXPAND YOUR POSSIBILITIES',description:'从感知到计算，把机器人的能力向外延伸。',href:'/products/#accessories',image:'/images/catalog/lidar.webp'}];
---
<Layout darkHeader schema={schema}>
  <section class="home-hero"><img src="/images/scenes/future.jpg" width="1600" height="900" alt="智能四足机器人面向未来城市的概念场景" fetchpriority="high"/><div class="hero-overlay"></div><div class="container hero-copy"><span class="hero-label">ROBOTDOG / INTELLIGENCE IN MOTION</span><h1>不止行走。<br/>走向未来。</h1><p>从第一台机器狗，到下一种可能。<br/>让智能走进生活、实验室与真实世界。</p><div class="hero-actions"><a href="/products/" class="button button-blue">探索产品系列 <Icon name="arrow" size={19}/></a><a href="/journal/" class="hero-text-link">探索与未来 <Icon name="diagonal" size={18}/></a></div></div><div class="container hero-floor"><a href="#lineup">向下探索 <span>↓</span></a><span>THE FUTURE IS CLOSER THAN YOU THINK.</span><span class="hero-page">01 <i></i> 01</span></div></section>
  <section class="home-categories" id="lineup"><div class="container"><div class="section-heading"><div><span class="eyebrow">MEET THE ROBOTS</span><h2>一个平台，无限可能。</h2></div><a href="/products/" class="text-link">发现完整产品系列 <Icon name="arrow"/></a></div><div class="category-grid">{categories.map(category=><a href={category.href} class="category-card"><span class="eyebrow">{category.en}</span><div class="category-image"><img src={category.image} width="720" height="540" alt={category.name+'机器狗与智能机器人产品示意'} loading="lazy"/></div><div class="category-copy"><h3>{category.name}<Icon name="diagonal" size={22}/></h3><p>{category.description}</p></div></a>)}</div></div></section>
  <section class="home-products section"><div class="container"><div class="section-heading"><div><span class="eyebrow">FIND YOUR NEXT ROBOT</span><h2>下一台，选它。</h2></div><p>看得见的配置，找得到的方向。<br/>从消费体验到行业应用，开始你的机器人旅程。</p></div><div class="home-product-grid">{featured.map((product,index)=><ProductCard product={product!} index={index}/>)}</div><div class="home-product-bottom"><p>效果预览：价格和配置为展示样例，实际商品信息以正式确认内容为准。</p><a href="/products/" class="text-link">查看全部产品与配件 <Icon name="arrow" size={18}/></a></div></div></section>
  <section class="home-application"><div class="application-picture"><img src="/images/scenes/inspection.jpg" alt="工业机器狗在能源设备现场的巡检概念场景" width="1600" height="900" loading="lazy"/></div><div class="application-copy"><span class="eyebrow">REAL WORLD. REAL POSSIBILITIES.</span><h2>让每一次出发，<br/>都回应真实需求。</h2><p>走进园区、工厂与实验室，把移动、感知与任务连接起来。让机器人承担它擅长的那一部分，让人专注于更重要的创造。</p><a href="/solutions/inspection/" class="button button-blue">探索行业巡检 <Icon name="arrow"/></a><div class="application-links"><a href="/solutions/education/">教育科研 <Icon name="diagonal" size={15}/></a><a href="/solutions/rescue/">应急探索 <Icon name="diagonal" size={15}/></a><a href="/solutions/exhibition/">互动展示 <Icon name="diagonal" size={15}/></a></div></div></section>
  <section class="home-future"><div class="container"><span class="eyebrow">BEYOND WHAT’S POSSIBLE TODAY</span><h2>未来，并非遥不可及。</h2><p>具身智能 · 世界模型 · 空间感知 · 多机器人协作<br/>让算法拥有行动力，让想象拥有真实的坐标。</p><a href="/journal/" class="button button-white">进入探索与未来 <Icon name="diagonal"/></a><div class="future-axis"><span>PERCEIVE</span><i></i><span>UNDERSTAND</span><i></i><span>ACT</span></div></div><div class="future-glow"></div><span class="future-word" aria-hidden="true">WHAT’S NEXT.</span></section>
  <section class="section home-journal"><div class="container"><div class="section-heading"><div><span class="eyebrow">EXPLORATION & FUTURE</span><h2>看见下一种可能。</h2></div><a href="/journal/" class="text-link">进入未来实验室 <Icon name="arrow"/></a></div><div class="home-journal-grid">{articles.slice(-3).map(article=><a class="home-story" href={`/journal/${article.slug}/`}><div class="home-story-image"><img src={article.coverImage} width="1600" height="900" alt={article.title+'科技场景示意'} loading="lazy"/><span><Icon name="diagonal" size={21}/></span></div><div class="home-story-meta"><span>{article.category}</span><span>未来观察</span></div><h3>{article.title}</h3><p>{article.excerpt}</p></a>)}</div></div></section>
  <section class="home-about"><img src="/images/scenes/team.jpg" alt="机器人设计与应用探索工作室概念图" width="1600" height="900" loading="lazy"/><div class="home-about-copy"><span class="eyebrow">ABOUT ROBOTDOG</span><h2>把复杂的技术，<br/>连接简单的开始。</h2><p>我们围绕你的需求，整理产品、配置与应用方向。<br/>在科技的下一步，与你一起向前。</p><a href="/about/" class="text-link">了解 RobotDog <Icon name="diagonal" size={19}/></a></div></section>
</Layout>
<style>
.home-hero{height:780px;min-height:650px;margin-top:82px;position:relative;overflow:hidden;background:#09172b;color:#fff}.home-hero>img{position:absolute;width:100%;height:100%;object-fit:cover;object-position:65% 50%}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,#041121b8,#05162b50 45%,#0000 77%),linear-gradient(0deg,#04122280,#0000 45%)}.hero-copy{position:relative;padding-top:176px}.hero-label{font-size:10px;letter-spacing:2px;color:#b7c9e1}.hero-copy h1{font-size:76px;font-weight:500;letter-spacing:-3px;line-height:1.3;margin:25px 0}.hero-copy>p{font-size:14px;line-height:1.9;color:#d1d9e4}.hero-actions{display:flex;align-items:center;gap:34px;margin-top:35px}.hero-text-link{display:flex;align-items:center;gap:15px;font-size:13px;color:#dde9f9}.hero-floor{position:absolute;bottom:30px;left:0;right:0;display:flex;justify-content:space-between;align-items:center;color:#b8c9dd;font-size:9px;letter-spacing:1px}.hero-floor>a{display:flex;gap:16px;align-items:center}.hero-floor>a span{font-size:19px}.hero-page{display:flex;gap:12px;align-items:center}.hero-page i{height:1px;width:55px;background:#ffffff60}.home-categories{padding:80px 0 70px;background:#fff}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.category-card{background:#f5f6f8;padding:27px 28px 29px}.category-card>.eyebrow{font-size:8px;color:#a2a8b2}.category-image{height:265px;margin:8px -8px}.category-image img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform .5s}.category-card:hover img{transform:scale(1.04)}.category-copy h3{font-size:23px;font-weight:500;display:flex;align-items:center;justify-content:space-between}.category-copy p{font-size:11px;color:#9199a5;margin-top:13px;line-height:1.9}.home-products{padding-top:40px;background:#fff}.home-product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.home-product-bottom{display:flex;justify-content:space-between;align-items:center;gap:30px;margin-top:24px}.home-product-bottom p{font-size:10px;color:#a0a7b1}.home-product-bottom a{font-size:11px}.home-application{display:grid;grid-template-columns:1.1fr 1fr;min-height:620px;background:#070d17;color:#fff}.application-picture{overflow:hidden}.application-picture img{width:100%;height:100%;object-fit:cover;object-position:70% 50%}.application-copy{padding:80px 9% 70px 13%;display:flex;flex-direction:column;justify-content:center}.application-copy .eyebrow{color:#718aaf;font-size:8px}.application-copy h2{font-size:37px;font-weight:500;line-height:1.55;margin:23px 0}.application-copy>p{font-size:13px;line-height:2;color:#8c9cb2;max-width:400px}.application-copy .button{align-self:start;margin-top:28px}.application-links{margin-top:39px;display:flex;gap:25px;flex-wrap:wrap}.application-links a{font-size:11px;color:#889dbe;display:flex;gap:8px;align-items:center}.home-future{position:relative;overflow:hidden;background:#07152a;color:#fff;text-align:center;padding:112px 0 106px}.home-future .container{position:relative;z-index:2}.home-future .eyebrow{justify-content:center;font-size:9px;color:#6c9ad7}.home-future h2{font-size:48px;font-weight:500;letter-spacing:-1px;margin:25px 0}.home-future p{font-size:13px;line-height:2.1;color:#91aacb}.home-future .button{margin-top:30px;font-size:12px}.future-axis{display:flex;align-items:center;justify-content:center;gap:23px;margin-top:54px;font-size:9px;letter-spacing:2px;color:#578ed4}.future-axis i{height:1px;width:80px;background:#284f83}.future-glow{position:absolute;width:950px;height:700px;left:50%;top:25%;transform:translateX(-50%);border-radius:50%;background:radial-gradient(ellipse,#1676ff36,transparent 65%)}.future-word{position:absolute;bottom:-35px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:130px;font-weight:800;letter-spacing:-8px;color:transparent;-webkit-text-stroke:1px #2c59834d}.home-journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.home-story-image{height:240px;position:relative;overflow:hidden;background:#0b1525}.home-story-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.home-story:hover img{transform:scale(1.035)}.home-story-image>span{position:absolute;right:17px;bottom:17px;width:33px;height:33px;background:#fff;display:grid;place-items:center}.home-story-meta{display:flex;justify-content:space-between;font-size:10px;color:#949ca9;margin-top:22px}.home-story-meta span:first-child{color:#4b8fe8}.home-story h3{font-size:21px;font-weight:500;margin:11px 0}.home-story>p{font-size:12px;color:#949ca8;line-height:1.9}.home-about{display:grid;grid-template-columns:1.05fr 1fr;background:#f5f7fa}.home-about>img{width:100%;height:510px;object-fit:cover}.home-about-copy{padding:70px 13%;display:flex;flex-direction:column;justify-content:center}.home-about h2{font-size:37px;font-weight:500;line-height:1.5;margin:22px 0}.home-about p{font-size:12px;color:#8c97a7;line-height:1.95}.home-about .text-link{margin-top:29px;color:#1676ff;font-size:12px}
@media(max-width:1150px){.home-product-grid{grid-template-columns:repeat(3,1fr)}.home-product-grid>:last-child{display:none}.category-image{height:220px}.category-card{padding:22px}.application-copy h2{font-size:32px}.home-story-image{height:210px}.home-about h2{font-size:33px}.home-about-copy{padding:60px 10%}}
@media(max-width:850px){.home-hero{margin-top:72px;height:700px}.hero-copy{padding-top:165px}.hero-copy h1{font-size:64px}.hero-floor>span:nth-child(2){display:none}.category-image{height:190px}.category-card{padding:20px}.category-copy h3{font-size:20px}.home-application{min-height:530px}.application-copy{padding:60px 9%}.application-copy h2{font-size:28px}.application-copy>p{font-size:12px}.application-links{gap:15px}.home-future h2{font-size:39px}.home-story h3{font-size:18px}.home-story-image{height:180px}.home-about>img{height:460px}.home-about h2{font-size:29px}.home-about-copy{padding:40px 9%}}
@media(max-width:640px){.home-hero{margin-top:66px;height:710px;min-height:650px}.home-hero>img{object-position:70% 50%}.hero-overlay{background:linear-gradient(90deg,#041121bb,#0615293b),linear-gradient(0deg,#061225aa,#07132800 60%)}.hero-copy{padding-top:148px}.hero-label{font-size:7px;letter-spacing:1.4px}.hero-copy h1{font-size:49px;letter-spacing:-2px;margin:25px 0}.hero-copy>p{font-size:12px}.hero-actions{gap:24px;flex-wrap:wrap;margin-top:29px}.hero-actions .button{font-size:11px;padding:11px 18px;gap:20px}.hero-text-link{font-size:11px;gap:10px}.hero-floor{bottom:22px;font-size:8px}.hero-page i{width:37px}.home-categories{padding:55px 0 40px}.category-grid{grid-template-columns:1fr;gap:15px}.category-card{padding:23px}.category-image{height:240px}.category-card>.eyebrow{font-size:8px}.category-copy h3{font-size:24px}.category-copy p{font-size:12px}.home-product-grid{grid-template-columns:1fr 1fr;gap:12px}.home-product-grid>:last-child{display:block}.home-product-bottom{flex-direction:column;align-items:start;gap:16px}.home-product-bottom p{font-size:9px}.home-application{grid-template-columns:1fr}.application-picture{height:335px}.application-copy{padding:43px 25px 45px}.application-copy h2{font-size:31px}.application-copy .eyebrow{font-size:8px}.application-copy>p{font-size:12px}.application-links{margin-top:32px}.home-future{padding:78px 0 75px}.home-future h2{font-size:31px;margin:23px 0}.home-future p{font-size:11px}.home-future .eyebrow{font-size:7px}.future-axis{gap:15px;font-size:7px;letter-spacing:1px;margin-top:40px}.future-axis i{width:26px}.future-word{font-size:78px;letter-spacing:-5px;bottom:-18px}.home-journal-grid{grid-template-columns:1fr;gap:35px}.home-story-image{height:240px}.home-story h3{font-size:22px}.home-story>p{font-size:12px}.home-about{grid-template-columns:1fr}.home-about>img{height:280px}.home-about-copy{padding:42px 25px 48px}.home-about h2{font-size:31px}.home-about p{font-size:12px}}
</style>
