---
import { siteUrl } from '../../config/site';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { solutions, type Solution } from '../../data/solutions';
import { products } from '../../data/catalog';
export function getStaticPaths() { return solutions.map((solution) => ({ params: { slug: solution.slug }, props: { solution } })); }
const { solution } = Astro.props as { solution: Solution };
const recommended = solution.productSlugs.map((slug) => products.find((product) => product.slug === slug)).filter(Boolean);
const related = solutions.filter((item) => item.slug !== solution.slug).slice(0, 3);
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
  { '@type': 'ListItem', position: 2, name: '应用场景', item: `${siteUrl}/solutions/` },
  { '@type': 'ListItem', position: 3, name: solution.name, item: `${siteUrl}/solutions/${solution.slug}/` },
] };
---
<Layout title={`${solution.name}玩具机器人车方案｜配置建议、应用需求与实施流程｜RobotCar`} description={solution.description} schema={schema}>
  <section class="application-hero"><img src={solution.image} alt={solution.imageAlt} width="1536" height="1024" fetchpriority="high"/><div class="application-shade"></div><div class="container application-copy"><nav aria-label="面包屑导航"><a href="/">首页</a><span>/</span><a href="/solutions/">应用场景</a><span>/</span><span aria-current="page">{solution.name}</span></nav><span class="application-kicker">{solution.eyebrow}</span><h1>{solution.headline.split('\n').map((line) => <span>{line}</span>)}</h1><p>{solution.description}</p><div class="application-actions"><button data-inquiry data-product={`${solution.name}应用方案`}>咨询场景配置 <Icon name="diagonal" size={18}/></button><a href="#opportunities">了解方案 <Icon name="arrow" size={18}/></a></div></div><div class="application-hero-bottom container"><span>{solution.name} / ROBOTCAR SOLUTIONS</span><span>让每一步，回应真实需求。</span></div></section>
  <section class="container application-context" id="opportunities"><div><span class="application-kicker">A TASK. A PLATFORM. A POSSIBILITY.</span><h2>{solution.name}<br/>从任务出发，连接可能。</h2></div><div><p>{solution.context}</p><div class="application-tags">{solution.tags.map((tag) => <span>{tag}</span>)}</div></div></section>
  <section class="application-opportunities"><div class="container"><div class="application-section-heading"><span class="application-kicker">WHERE IDEAS MEET THE REAL WORLD</span><h2>找到技术与场景的连接点。</h2></div><div class="opportunity-grid">{solution.opportunities.map((item, index) => <article><div><Icon name={item.icon} size={34}/><span>0{index + 1}</span></div><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <section class="application-statement"><img src={solution.image} alt={`${solution.name}应用环境概念画面`} width="1536" height="1024" loading="lazy"/><div class="statement-shade"></div><div><span class="application-kicker">THINK BIG. START CLEAR.</span><h2>把精彩的想象，<br/>变成可以验证的下一步。</h2><a href={`/journal/${solution.articleSlug}/`}>阅读相关探索 <Icon name="diagonal" size={18}/></a></div></section>
  <section class="container application-process"><div class="application-section-heading"><span class="application-kicker">FROM AN IDEA TO A CLEAR PLAN</span><h2>一条清晰的实践路径。</h2></div><div class="application-process-grid">{solution.workflow.map((step, index) => <article><span>0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></section>
  <section class="application-requirements"><div class="container requirements-inner"><div><span class="application-kicker">MAKE THE CONVERSATION CONCRETE</span><h2>带上这些信息，<br/>开始一次更具体的沟通。</h2><p>完整的配置，需要结合机型文档、接口兼容性与现场验证确认。</p></div><ul>{solution.requirements.map((item) => <li><Icon name="check" size={20}/>{item}</li>)}</ul></div></section>
  <section class="container application-products"><div class="application-section-heading products-heading"><div><span class="application-kicker">EXPLORE YOUR PLATFORM</span><h2>从合适的平台开始。</h2></div><a href="/products/">查看全部产品 <Icon name="arrow" size={18}/></a></div>{recommended.length > 0 ? <div class="application-product-grid">{recommended.map((product) => product && <a href={`/products/${product.slug}/`}><div class="application-product-image"><img src={product.image} alt={product.name} width="800" height="700" loading="lazy"/></div><div class="application-product-copy"><span>{product.category}</span><h3>{product.name}</h3><p>{product.tagline}</p><span class="application-product-link">查看配置与参数 <Icon name="diagonal" size={18}/></span></div></a>)}</div> : <a class="application-catalog-link" href="/products/">按用途浏览玩具机器人车与扩展配件 <Icon name="diagonal"/></a>}</section>
  <section class="application-related"><div class="container"><div class="application-section-heading"><span class="application-kicker">KEEP EXPLORING</span><h2>发现更多应用可能。</h2></div><div class="application-related-grid">{related.map((item) => <a href={`/solutions/${item.slug}/`}><img src={item.image} alt={item.imageAlt} width="1536" height="1024" loading="lazy"/><div><h3>{item.name}</h3><Icon name="diagonal" size={20}/></div></a>)}</div></div></section>
</Layout>
<style>
  .application-hero{position:relative;margin-top:80px;min-height:700px;color:#fff;background:#070d18;overflow:hidden}.application-hero>img,.application-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.application-shade{background:linear-gradient(90deg,#020814ed,#02081495 55%,#02081422),linear-gradient(0deg,#0208149c,transparent 65%)}.application-copy{position:relative;z-index:1;padding-top:35px;padding-bottom:120px}.application-copy nav{display:flex;gap:13px;align-items:center;color:#b0bdd1;font-size:11px;margin-bottom:85px}.application-copy nav a:hover{color:#fff}.application-kicker{font-size:11px;color:#1674ff;letter-spacing:.16em;font-weight:600}.application-copy>.application-kicker{color:#a7caff}.application-copy h1{font-size:clamp(39px,4.6vw,66px);line-height:1.25;letter-spacing:-.035em;margin:25px 0}.application-copy h1 span{display:block}.application-copy>p{max-width:590px;font-size:16px;line-height:1.9;color:#c2cddd;margin-bottom:30px}.application-actions{display:flex;align-items:center;gap:30px}.application-actions button{display:inline-flex;align-items:center;gap:25px;background:#1674ff;color:#fff;padding:15px 25px;font-size:14px}.application-actions a{display:flex;gap:15px;align-items:center;font-size:14px}.application-hero-bottom{position:absolute;left:0;right:0;bottom:32px;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.09em;color:#a5b5ce}.application-context{display:grid;grid-template-columns:1fr 1.2fr;gap:100px;padding:95px 0;align-items:start;scroll-margin-top:100px}.application-context h2{font-size:39px;letter-spacing:-.025em;line-height:1.45;margin:23px 0 0}.application-context p{font-size:16px;line-height:2;color:#707a88;margin:0}.application-tags{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.application-tags>span{padding:7px 13px;font-size:11px;border:1px solid #dce3ed;color:#5b6d83}.application-opportunities{padding:85px 0;background:#f5f7fa}.application-section-heading h2{font-size:37px;letter-spacing:-.025em;margin:22px 0 40px;line-height:1.35}.opportunity-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.opportunity-grid article{background:#fff;padding:35px}.opportunity-grid article>div{display:flex;align-items:center;justify-content:space-between;color:#1674ff}.opportunity-grid article>div span{color:#abb5c3;font-size:11px}.opportunity-grid h3{font-size:24px;margin:35px 0 17px}.opportunity-grid p{font-size:14px;line-height:1.95;color:#737c89}.application-statement{position:relative;min-height:580px;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;overflow:hidden;background:#080d17}.application-statement>img,.statement-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.statement-shade{background:#040b17b5}.application-statement>div:last-child{position:relative;padding:70px 25px}.application-statement .application-kicker{color:#adcaff}.application-statement h2{font-size:clamp(35px,4vw,58px);line-height:1.35;margin:25px 0 30px;letter-spacing:-.02em}.application-statement a{display:inline-flex;gap:17px;align-items:center;font-size:14px;border-bottom:1px solid #ffffff75;padding:0 0 11px}.application-process{padding:90px 0}.application-process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:35px}.application-process-grid article{border-top:2px solid #1674ff;padding-top:25px}.application-process-grid article>span{font-size:28px;color:#1674ff;font-weight:500}.application-process-grid h3{font-size:21px;margin:25px 0 15px}.application-process-grid p{font-size:14px;line-height:1.9;color:#717c8b}.application-requirements{background:#0a101c;color:#fff;padding:80px 0}.requirements-inner{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}.requirements-inner .application-kicker{color:#9dc4ff}.requirements-inner h2{font-size:35px;line-height:1.4;margin:23px 0}.requirements-inner p{color:#8d9ab1;font-size:13px;line-height:1.9}.requirements-inner ul{list-style:none;margin:0;padding:0;display:grid;gap:0}.requirements-inner li{display:flex;gap:15px;align-items:center;border-bottom:1px solid #ffffff1c;padding:21px 0;font-size:14px;line-height:1.7;color:#d2dbea}.requirements-inner li svg{color:#78acff;flex-shrink:0}.application-products{padding:90px 0}.products-heading{display:flex;justify-content:space-between;gap:25px;align-items:end}.products-heading>a{display:flex;gap:15px;align-items:center;margin-bottom:45px;font-size:13px}.application-product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:25px}.application-product-grid>a{border:1px solid #e8ecf1;background:#fff;display:grid;grid-template-columns:1.1fr 1fr;align-items:center}.application-product-image{aspect-ratio:1;background:#f4f5f7;overflow:hidden;display:flex;align-items:center}.application-product-image img{width:100%;height:100%;object-fit:contain;padding:20px;transition:transform .4s}.application-product-grid a:hover img{transform:scale(1.06)}.application-product-copy{padding:25px}.application-product-copy>span:first-child{font-size:10px;color:#7b8594}.application-product-copy h3{font-size:23px;margin:15px 0}.application-product-copy p{font-size:12px;line-height:1.8;color:#748094}.application-product-link{margin-top:25px;font-size:11px;display:flex;justify-content:space-between;gap:10px;align-items:center;color:#1674ff}.application-catalog-link{display:flex;align-items:center;gap:25px;padding:40px;background:#f2f5f9;font-size:18px}.application-related{padding:80px 0;background:#f4f6f9}.application-related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.application-related-grid>a{position:relative;overflow:hidden;aspect-ratio:1.3;color:#fff;background:#080d17}.application-related-grid img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.application-related-grid a:hover img{transform:scale(1.04)}.application-related-grid a:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#030a18df,transparent 75%)}.application-related-grid a>div{position:absolute;left:24px;right:24px;bottom:24px;display:flex;justify-content:space-between;align-items:center;z-index:1}.application-related-grid h3{font-size:23px}
  @media(max-width:1000px){.application-context,.requirements-inner{gap:45px}.opportunity-grid article{padding:26px}.application-context h2{font-size:32px}.application-product-grid>a{grid-template-columns:1fr}.application-product-image{aspect-ratio:1.3}.application-process-grid{gap:22px}.application-process-grid h3{font-size:18px}}
  @media(max-width:640px){.application-hero{margin-top:68px;min-height:650px}.application-hero>img{object-position:65% 50%}.application-copy{padding-top:25px;padding-bottom:110px}.application-copy nav{font-size:9px;gap:9px;margin-bottom:85px}.application-copy h1{font-size:38px;line-height:1.35;letter-spacing:-.05em;margin:24px 0}.application-copy>p{font-size:13px;max-width:350px;margin-bottom:25px}.application-kicker{font-size:9px}.application-actions{gap:25px}.application-actions button{padding:13px 17px;font-size:11px;gap:13px}.application-actions a{font-size:11px;gap:10px}.application-hero-bottom{bottom:27px;font-size:8px;gap:15px}.application-hero-bottom>span:last-child{display:none}.application-context{grid-template-columns:1fr;gap:26px;padding:55px 0}.application-context h2{font-size:30px;margin-top:19px}.application-context p{font-size:14px;line-height:1.95}.application-tags{margin-top:22px}.application-tags>span{font-size:10px;padding:6px 10px}.application-opportunities{padding:55px 0}.application-section-heading h2{font-size:27px;margin:20px 0 28px}.opportunity-grid{grid-template-columns:1fr;gap:16px}.opportunity-grid article{padding:27px}.opportunity-grid h3{font-size:22px;margin-top:27px}.opportunity-grid p{font-size:13px}.application-statement{min-height:430px}.application-statement h2{font-size:31px}.application-statement a{font-size:12px}.application-process{padding:55px 0}.application-process-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 20px}.application-process-grid article>span{font-size:25px}.application-process-grid h3{font-size:17px;margin:18px 0 10px}.application-process-grid p{font-size:12px}.application-requirements{padding:55px 0}.requirements-inner{grid-template-columns:1fr;gap:20px}.requirements-inner h2{font-size:28px}.requirements-inner li{font-size:12px;padding:18px 0}.application-products{padding:55px 0}.products-heading{align-items:center;gap:15px}.products-heading>a{font-size:10px;gap:7px;margin-bottom:25px;white-space:nowrap}.products-heading h2{font-size:26px}.application-product-grid{grid-template-columns:1fr;gap:18px}.application-product-grid>a{grid-template-columns:1fr 1fr}.application-product-image{aspect-ratio:1}.application-product-copy{padding:18px}.application-product-copy h3{font-size:18px;margin:11px 0}.application-product-copy p{font-size:11px}.application-product-link{font-size:10px;margin-top:18px}.application-related{padding:55px 0}.application-related-grid{grid-template-columns:1fr;gap:18px}.application-related-grid>a{aspect-ratio:1.65}.application-related-grid h3{font-size:25px}}
</style>
