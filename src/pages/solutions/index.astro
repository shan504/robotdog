---
import { siteUrl } from '../../config/site';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { solutions } from '../../data/solutions';
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首页', item: `${siteUrl}/` },
  { '@type': 'ListItem', position: 2, name: '应用场景', item: `${siteUrl}/solutions/` },
] };
---
<Layout title="玩具机器人车应用场景｜智慧赛道探索、STEM 教育、车载智能与科技互动｜RobotCar" description="探索智能玩具车在遥控竞速、编程教学、户外趣玩、积木任务、创客拼装与科技互动中的应用方案，查看场景需求、配置建议和验证流程。" schema={schema}>
  <section class="scene-hero">
    <img src="/images/scenes/race.webp" alt="遥控玩具车在模型赛道上竞速的概念场景" width="1536" height="1024" fetchpriority="high"/>
    <div class="scene-hero-shade"></div>
    <div class="scene-hero-copy"><span>ROBOTCAR / REAL WORLD. NEW POSSIBILITIES.</span><h1>从一辆小车，<br/>驶向新玩法。</h1><p>从一道弯，到一行代码。<br/>让小车的每一次出发，都成为创意的起点。</p><a href="#applications" class="scene-button">探索应用场景 <Icon name="arrow" size={18}/></a></div>
    <div class="scene-hero-caption"><span>APPLICATION SCENARIOS</span><span>感知 · 移动 · 连接</span></div>
  </section>
  <section class="scene-intro container" id="applications"><div><span class="scene-kicker">BUILT FOR WHAT’S NEXT</span><h2>技术的精彩，<br/>发生在每一种现场。</h2></div><p>课堂里，一次真实的运动让原理变得清晰。<br/>家庭里，一次有趣的挑战让合作成为快乐。<br/>从玩法出发，找到适合你的玩具车套装。</p></section>
  <section class="container scene-grid" aria-label="六大玩具车玩法场景">
    {solutions.map((solution, index) => <a class="scene-card" href={`/solutions/${solution.slug}/`}>
      <div class:list={['scene-card-image', `scene-${solution.slug}`]}><img src={solution.image} alt={solution.imageAlt} width="1536" height="1024" loading="lazy"/><div class="scene-card-shade"></div><span class="scene-card-number">0{index + 1} / {solution.eyebrow}</span><div class="scene-card-title"><h2>{solution.name}</h2><span class="scene-card-arrow"><Icon name="diagonal" size={22}/></span></div></div>
      <div class="scene-card-info"><h3>{solution.headline.replace('\n', '')}</h3><p>{solution.description}</p><div class="scene-card-tags">{solution.tags.map((tag) => <span>{tag}</span>)}</div></div>
    </a>)}
  </section>
  <section class="scene-feature"><img src="/images/scenes/workshop.webp" alt="智能玩具车研发与教学空间的概念场景" width="1536" height="1024" loading="lazy"/><div class="scene-feature-shade"></div><div class="container scene-feature-content"><span class="scene-kicker">FROM THE LAB TO THE WORLD</span><h2>想法的边界，<br/>值得用行动去突破。</h2><p>把感知、计算和运动放进同一个真实循环。<br/>用一次次可复现的实验，让创新有迹可循。</p><a href="/solutions/workshop/" class="scene-button">走进创客拼装 <Icon name="diagonal" size={18}/></a></div></section>
  <section class="container scene-path"><div><span class="scene-kicker">FIND YOUR STARTING POINT</span><h2>下一步，从你的任务开始。</h2><p>选择产品只是起点。年龄、场地、操控方式与课程目标，让套装更贴合你的需要。</p></div><div class="scene-path-links"><a href="/products/">浏览产品与配件 <Icon name="diagonal"/></a><a href="/journal/how-to-choose-a-robot-car/">阅读玩具机器人车选型指南 <Icon name="diagonal"/></a><button data-inquiry>整理我的场景需求 <Icon name="diagonal"/></button></div></section>
</Layout>
<style>
  .scene-hero{position:relative;height:740px;min-height:600px;background:#080c14;overflow:hidden;color:#fff;margin-top:80px}.scene-hero>img,.scene-hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.scene-hero>img{object-position:center 55%}.scene-hero-shade{background:linear-gradient(90deg,#030915a8,#03091530 65%),linear-gradient(0deg,#050b19a6,transparent 60%)}.scene-hero-copy{position:relative;z-index:1;text-align:center;padding:155px 24px 0;max-width:880px;margin:auto}.scene-hero-copy>span{font-size:12px;letter-spacing:.22em;color:#c1d2ed}.scene-hero h1{font-size:clamp(48px,5vw,76px);font-weight:600;line-height:1.2;letter-spacing:-.04em;margin:28px 0 25px}.scene-hero-copy>p{font-size:18px;line-height:1.9;color:#dae1ec;margin:0 0 34px}.scene-button{display:inline-flex;gap:26px;align-items:center;justify-content:center;padding:15px 25px;background:#1674ff;color:#fff;font-size:14px;transition:background .25s}.scene-button:hover{background:#408eff}.scene-hero-caption{position:absolute;left:6%;right:6%;bottom:30px;display:flex;justify-content:space-between;font-size:11px;color:#c0cee4;letter-spacing:.13em}.scene-kicker{font-size:11px;font-weight:600;letter-spacing:.17em;color:#1674ff}.scene-intro{padding:100px 0 65px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end;scroll-margin-top:100px}.scene-intro h2{font-size:clamp(30px,3.2vw,48px);line-height:1.35;letter-spacing:-.025em;margin:22px 0 0;font-weight:600}.scene-intro>p{font-size:16px;line-height:2;color:#727984;margin:0 0 4px}.scene-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 28px;padding-bottom:100px}.scene-card{display:block}.scene-card-image{position:relative;aspect-ratio:1.35;overflow:hidden;background:#0b1423;color:#fff}.scene-card-image>img{width:100%;height:100%;object-fit:cover;transition:transform .7s}.scene-card:hover .scene-card-image>img{transform:scale(1.04)}.scene-card-shade{position:absolute;inset:0;background:linear-gradient(0deg,#030b1be6,transparent 60%)}.scene-card-number{position:absolute;top:25px;left:28px;font-size:10px;letter-spacing:.1em;color:#ebf1fa}.scene-card-title{position:absolute;left:28px;right:28px;bottom:28px;display:flex;align-items:center;justify-content:space-between}.scene-card-title h2{font-size:31px;font-weight:600;letter-spacing:-.03em}.scene-card-arrow{width:43px;height:43px;display:grid;place-items:center;border:1px solid #ffffff70;border-radius:50%;transition:background .25s}.scene-card:hover .scene-card-arrow{background:#1674ff;border-color:#1674ff}.scene-card-info{padding:25px 4px 0}.scene-card-info h3{font-size:20px;margin:0 0 12px;line-height:1.6;letter-spacing:-.02em}.scene-card-info p{font-size:14px;line-height:1.85;color:#737b87;margin:0;max-width:560px}.scene-card-tags{display:flex;gap:10px;flex-wrap:wrap;margin-top:19px}.scene-card-tags span{font-size:11px;color:#637083;border:1px solid #e1e5eb;padding:5px 10px}.scene-logistics img{object-position:30% 50%}.scene-exhibition img{object-position:60% 50%}.scene-feature{position:relative;background:#070d17;min-height:640px;color:#fff;display:flex;align-items:center;overflow:hidden}.scene-feature>img,.scene-feature-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.scene-feature-shade{background:linear-gradient(90deg,#020914e6,#02091485 55%,#02091420)}.scene-feature-content{position:relative;padding-top:80px;padding-bottom:80px}.scene-feature .scene-kicker{color:#a2c5ff}.scene-feature h2{font-size:clamp(34px,4vw,58px);line-height:1.3;letter-spacing:-.025em;margin:24px 0}.scene-feature p{font-size:16px;line-height:1.9;color:#c0cddf;margin:0 0 32px}.scene-path{display:grid;grid-template-columns:1.25fr 1fr;gap:100px;padding:90px 0;align-items:center}.scene-path h2{font-size:34px;margin:20px 0}.scene-path p{font-size:14px;line-height:1.9;color:#727b89;max-width:560px}.scene-path-links{display:grid}.scene-path-links a,.scene-path-links button{display:flex;justify-content:space-between;align-items:center;text-align:left;padding:23px 0;border-bottom:1px solid #e0e5ed;font-size:15px;background:none}.scene-path-links a:hover,.scene-path-links button:hover{color:#1674ff}
  @media(max-width:900px){.scene-hero{height:660px;margin-top:72px}.scene-intro{gap:35px}.scene-hero-copy{padding-top:135px}.scene-card-title h2{font-size:27px}.scene-card-info h3{font-size:18px}.scene-path{gap:40px}.scene-path h2{font-size:29px}}
  @media(max-width:640px){.scene-hero{margin-top:68px;height:630px;min-height:0}.scene-hero>img{object-position:60% 50%}.scene-hero-copy{padding:135px 22px 0}.scene-hero-copy>span{font-size:9px;letter-spacing:.14em}.scene-hero h1{font-size:46px;margin:25px 0}.scene-hero-copy>p{font-size:14px;margin-bottom:28px}.scene-hero-caption{left:20px;right:20px;font-size:8px;bottom:25px}.scene-intro{padding:58px 0 35px;grid-template-columns:1fr;gap:22px}.scene-intro h2{font-size:32px}.scene-intro>p{font-size:13px;line-height:1.95}.scene-kicker{font-size:9px}.scene-grid{grid-template-columns:1fr;gap:35px;padding-bottom:60px}.scene-card-image{aspect-ratio:1.2}.scene-card-number{left:21px;top:20px;font-size:8px}.scene-card-title{left:21px;right:21px;bottom:23px}.scene-card-title h2{font-size:28px}.scene-card-info{padding-top:19px}.scene-card-info h3{font-size:18px}.scene-card-info p{font-size:13px}.scene-card-tags span{font-size:10px}.scene-feature{min-height:550px}.scene-feature>img{object-position:65% 50%}.scene-feature-shade{background:linear-gradient(90deg,#020914df,#02091470)}.scene-feature-content{padding:65px 0}.scene-feature h2{font-size:35px}.scene-feature p{font-size:13px}.scene-button{padding:13px 21px;font-size:12px;gap:20px}.scene-path{grid-template-columns:1fr;gap:20px;padding:55px 0}.scene-path h2{font-size:27px}.scene-path p{font-size:13px}.scene-path-links a,.scene-path-links button{font-size:13px;padding:20px 0}}
</style>
