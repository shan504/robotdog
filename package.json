{
  "name": "robotcar-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 0.0.0.0",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 0.0.0.0",
    "test": "playwright test",
    "export:preview": "node scripts/export-preview.mjs",
    "package:deploy": "npm run build && node scripts/package-deployment.mjs"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "esbuild": "0.28.2"
  }
}
